<Page xmlns="https://pcln.dev/pxml/2026" Key="VersionSubpage">
  <StackPanel Key="SubpageContent" Orientation="Vertical" Weight="1">
    <StackPanel Key="MigrationCard" Orientation="Vertical" Width="420" Height="256" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Spacing="14">
      <Image Key="MigrationIcon" Source="lucide/blocks" Width="36" Height="36" HorizontalAlignment="Center" />
      <Text Key="MigrationTitle" Content="尚未迁移" Height="30" HorizontalAlignment="Center" />
      <Text Key="MigrationMessage" Content="这项功能尚未迁移到 Nexa。你可以返回首页，继续选择版本和启动游戏。" Height="56" />
      <Button Key="MigrationReturn" Content="返回首页" Label="返回首页" Command="ui.navigation.launch" Width="128" Height="38" HorizontalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Page>
