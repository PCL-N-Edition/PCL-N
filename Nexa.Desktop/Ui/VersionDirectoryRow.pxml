<Button xmlns="https://pcln.dev/pxml/2026" Key="LibraryRow" Command="ui.versions.directory" Height="48">
  <StackPanel Orientation="Horizontal" Margin="10,0,16,0" Spacing="8">
    <Text Key="LibraryDirectoryRowName" Weight="1" VerticalAlignment="Center" />
    <Text Key="LibraryDirectoryRowPath" Weight="2" VerticalAlignment="Center" />
    <Image Key="LibraryDirectoryRowCheck" Source="lucide/check" Width="16" Height="16" VerticalAlignment="Center" />
    <Button Key="LibraryDirectoryRename" Label="修改文件夹名称" Command="ui.versions.rename" Icon="pcl/pencil" Width="28" Height="28" VerticalAlignment="Center" />
    <Button Key="LibraryDirectoryForget" Label="移除目录，保留文件" Command="ui.versions.forget" Icon="lucide/x" Width="28" Height="28" VerticalAlignment="Center" />
  </StackPanel>
</Button>
