<Page xmlns="https://pcln.dev/pxml/2026" Key="TaskCenterPage" Label="任务中心">
  <!--
    The task center page: one quiet surface for every background task the foundation tracks.
    The header carries the aggregate (progress, speed, remaining files) plus the bulk cleanup;
    the body reconciles one card per task entry at frame time. The empty state names the
    destination so the page is never a blank well (wayfinding), and the bubble yields while
    this page owns the corner.
  -->
  <StackPanel Key="TaskCenterRoot" Orientation="Vertical" Weight="1" Padding="4,8,4,8">
    <StackPanel Key="TaskCenterHeader" Orientation="Horizontal" Margin="0,0,0,8">
      <Image Key="TaskCenterHeaderIcon" Source="lucide/list-checks" Width="22" Height="22"
             Margin="0,2,10,0" IsVisible="false" />
      <Text Key="TaskCenterTitle" Content="任务中心" Height="38" Weight="1" />
      <Button Key="TaskCenterClear" Content="清除已完成" Label="清除已完成的任务"
              Command="ui.tasks.clear-finished" Width="124" Height="36" VerticalAlignment="Center" />
    </StackPanel>
    <Text Key="TaskCenterSummary" Content="暂无任务" Height="22" Margin="0,0,0,24" />
    <ContentHost Key="TaskCenterBody" Weight="1">
      <StackPanel Key="TaskCenterEmpty" Orientation="Vertical" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Key="TaskCenterEmptyIcon" Source="lucide/inbox" Width="36" Height="36"
               HorizontalAlignment="Center" />
        <Text Key="TaskCenterEmptyTitle" Content="暂无任务" Height="20" HorizontalAlignment="Center" />
        <Text Key="TaskCenterEmptyHint" Content="安装和下载进度会显示在这里。"
              Height="16" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Key="TaskCenterList" Orientation="Vertical" Spacing="14" IsVisible="false"
                  Scroll="true" />
    </ContentHost>
  </StackPanel>
</Page>
