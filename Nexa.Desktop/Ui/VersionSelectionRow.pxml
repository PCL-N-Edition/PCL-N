<Button xmlns="https://pcln.dev/pxml/2026" Key="LibraryRow" Command="ui.versions.select" Height="72">
  <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,12,16,12">
    <StackPanel Width="18" VerticalAlignment="Center">
      <Image Key="LibraryRowCheck" Source="lucide/check" Width="18" Height="18" />
    </StackPanel>
    <Image Key="LibraryRowIcon" Source="lucide/blocks" Width="28" Height="28" VerticalAlignment="Center" />
    <StackPanel Orientation="Vertical" Weight="1" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6" Height="24">
        <Text Key="LibraryRowName" Height="24" Weight="1" />
      </StackPanel>
      <Text Key="LibraryRowDetail" Height="20" />
    </StackPanel>
    <Button Key="LibraryRowModify" Icon="lucide/wrench" Content="修改" Command="ui.versions.modify" Width="76" Height="32" VerticalAlignment="Center" />
    <Button Key="LibraryRowSettings" Icon="lucide/settings" Content="设置" Command="ui.versions.settings" Width="76" Height="32" VerticalAlignment="Center" />
    <Button Key="LibraryRowDelete" Icon="lucide/trash-2" Content="删除" Command="ui.versions.delete" Width="76" Height="32" VerticalAlignment="Center" />
  </StackPanel>
</Button>
