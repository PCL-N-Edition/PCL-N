<Project>
  <!--
    Vendored third-party code under external/ (Jvm.NET / Asm port).
    Portable Core builds the full solution with -warnaserror. Command-line
    TreatWarningsAsErrors is a global MSBuild property and cannot be cleared here,
    so silence all warnings for this tree instead. File lives outside the submodule.
  -->
  <PropertyGroup>
    <WarningLevel>0</WarningLevel>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
