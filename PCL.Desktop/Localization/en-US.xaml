    <sys:String x:Key="Setup.Misc.Log.AllLogs">All logs</sys:String>
    <sys:String x:Key="Setup.Misc.Log.ClearHistory">Clear historical logs</sys:String>
    <sys:String x:Key="Setup.Misc.Log.Export">Export log</sys:String>
    <sys:String x:Key="Setup.Misc.Log.ExportAll">Export all logs</sys:String>
    <sys:String x:Key="Setup.Misc.Log.OpenDirectory">Open log folder</sys:String>
    <sys:String x:Key="Setup.Misc.Log.Operations">Log operations</sys:String>
    <sys:String x:Key="Setup.Misc.Network.DoH">Use DoH for address resolution</sys:String>
    <sys:String x:Key="Setup.Misc.Network.DoH.ToolTip">Using DoH for address resolution can provide better IP results and improve the launcher&#x27;s network access. If you have deployed a DoH resolution service, you can disable this feature.</sys:String>
    <sys:String x:Key="Setup.Misc.Network.HttpProxy">HTTP proxy</sys:String>
    <sys:String x:Key="Setup.Misc.Network.Proxy.Apply">Apply proxy information</sys:String>
    <sys:String x:Key="Setup.Misc.Network.Proxy.Custom">Custom proxy</sys:String>
    <sys:String x:Key="Setup.Misc.Network.Proxy.InvalidWarning">Incorrect proxy server addresses will cause network connection failures. Network issues caused by proxy usage will not be handled.&#x0a;Do not enter untrusted proxy server addresses, as this may lead to account information leakage or even account theft.</sys:String>
    <sys:String x:Key="Setup.Misc.Network.Proxy.None">No proxy</sys:String>
    <sys:String x:Key="Setup.Misc.Network.Proxy.Optional">If needed</sys:String>
