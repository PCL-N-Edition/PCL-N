    <sys:String x:Key="Setup.Launch.Advanced.Renderer.Vulkan">Vulkan (zink)</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.Title">Advanced launch options</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.UseJavaExe">Use java.exe instead of javaw.exe</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.UseJavaExe.ToolTip">Uses java.exe so the game process has standard input and output streams. This can help when the game window never appears or log output causes problems.&#x0a;&#x0a;Some Java distributions may lose operating-system features such as HDR when launched this way. Leave this off when Minecraft starts normally.</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.Label">Custom text</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.ToolTip">Appears in the lower-left corner of the title screen and the upper-left corner of the F3 debug screen.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All">Isolate every instance</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All.ToolTip">Keeps saves, mods, resource packs, and other files separate for every instance, including vanilla versions.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.Label">Default isolation</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedAndNonRelease">Isolate modded and non-release instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedOnly">Isolate modded instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedOnly.ToolTip">Keeps Forge, Fabric, and other modded instances separate to avoid conflicts. Vanilla instances remain shared.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.NonRelease">Isolate non-release instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.NonRelease.ToolTip">Keeps snapshots, pre-releases, early versions, and April Fools’ versions separate from other instances.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.None.ToolTip">All instances share one profile, including saves, mods, and resource packs.&#x0a;Using multiple modded instances this way can cause conflicts.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ToolTip">Sets the default isolation mode for newly installed instances. Existing instances can be changed in their own settings.</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Ipv4">Prefer IPv4</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Ipv6">Prefer IPv6</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.JavaDefault">Java default</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Label">IP protocol preference</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.ToolTip">Controls Minecraft’s IP preference through JVM arguments. Prefer IPv4 unless you specifically need IPv6.&#x0a;&#x0a;Prefer IPv4: -Djava.net.preferIPv4Stack=true&#x0a;Java default: no additional argument&#x0a;Prefer IPv6: -Djava.net.preferIPv6Stack=true</sys:String>
