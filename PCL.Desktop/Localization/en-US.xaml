    <sys:String x:Key="Setup.Launch.Advanced.Renderer.Vulkan">Vulkan (zink)</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.Title">Advanced launch options</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.UseJavaExe">Use java.exe instead of javaw.exe</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.UseJavaExe.ToolTip">Uses java.exe so the game process has standard input and output streams. This can help when the game window never appears or log output causes problems.&#x0a;&#x0a;Some Java distributions may lose operating-system features such as HDR when launched this way. Leave this off when Minecraft starts normally.</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.Label">Custom text</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.ToolTip">Appears in the lower-left corner of the title screen and the upper-left corner of the F3 debug screen.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All">Isolate every instance</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All.ToolTip">Keeps saves, mods, resource packs, and other files separate for every instance, including vanilla versions.</sys:String>
