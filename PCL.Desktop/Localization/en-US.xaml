    <sys:String x:Key="Setup.Launch.Java.Loading">Loading Java runtimes…</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Auto">Automatic</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Auto.ToolTip">Adjusts game memory based on installed mods and currently available system memory.</sys:String>
