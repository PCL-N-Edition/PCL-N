    <sys:String x:Key="Setup.Launch.Priority.RealTime">实时——最高优先级，可能影响系统稳定性</sys:String>
    <sys:String x:Key="Setup.Launch.SwitchToInstanceSetup">打开版本设置</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.CloseImmediately">Minecraft 启动后退出</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.HideAndCloseOnExit">Minecraft 运行时隐藏，退出游戏后关闭</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.HideAndReopenOnExit">Minecraft 运行时隐藏，退出游戏后重新显示</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.KeepUnchanged">保持显示</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.Label">启动器可见性</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.Minimize">Minecraft 启动后最小化</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Custom">自定义尺寸</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.CustomHeightBug.ToolTip">包括 Forge 1.12.2 在内的部分版本会忽略自定义高度。</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Fullscreen">全屏</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Label">窗口大小</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Maximized">最大化</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.ModernUiWarning">若 Modern UI 接管游戏窗口，此设置不会生效。</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.SameAsLauncher">与启动器窗口一致</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.Label">游戏窗口标题</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.SampleFormat">{name} | 玩家：{user} | 登录方式：{login}</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.ToolTip">自定义 Minecraft 窗口标题。留空则保留默认标题。&#x0a;支持以下标记：· {user}：玩家名称 · {login}：登录方式 · {name}：版本名称 · {date}、{time}：当前系统时间 · {version}：原版版本号&#x0a;若 Modern UI 接管窗口标题，此设置不会生效。</sys:String>
    <sys:String x:Key="Setup.LauncherLanguage.CardTitle">语言</sys:String>
    <sys:String x:Key="Setup.LauncherLanguage.FormatCulture">区域格式</sys:String>
