<Project>
  <!--
    PCL N uses LibVLC only for silent, local MP4/WebM/MKV/MOV backgrounds and
    renders through the vmem callback. Keep the container, decoder, packetizer,
    color conversion, and memory-output modules needed by that surface instead
    of shipping VLC's streaming, optical-disc, transcoding, and GUI features.

    Asterisks are escaped so VideoLAN.LibVLC.Windows.targets expands the globs
    relative to the selected native architecture rather than this project.
  -->
  <ItemGroup>
    <PclVlcPlaybackModule Include="libvlc.dll" />
    <PclVlcPlaybackModule Include="libvlccore.dll" />

    <PclVlcPlaybackModule Include="plugins\access\libfilesystem_plugin.dll" />

    <PclVlcPlaybackModule Include="plugins\codec\libaom_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\codec\libavcodec_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\codec\libdav1d_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\codec\librawvideo_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\codec\libvpx_plugin.dll" />

    <PclVlcPlaybackModule Include="plugins\demux\libes_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\demux\libh26x_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\demux\libmkv_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\demux\libmp4_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\demux\libogg_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\demux\libts_plugin.dll" />

    <PclVlcPlaybackModule Include="plugins\logger\libconsole_logger_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\packetizer\%2A%2A" />

    <PclVlcPlaybackModule Include="plugins\stream_filter\libcache_block_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\stream_filter\libcache_read_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\stream_filter\libprefetch_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\stream_filter\libskiptags_plugin.dll" />

    <PclVlcPlaybackModule Include="plugins\video_chroma\%2A%2A" />
    <PclVlcPlaybackModule Include="plugins\video_filter\libdeinterlace_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\video_filter\libfps_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\video_filter\libscale_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\video_filter\libtransform_plugin.dll" />
    <PclVlcPlaybackModule Include="plugins\video_output\libvmem_plugin.dll" />

    <VlcWindowsX64IncludeFiles Include="@(PclVlcPlaybackModule)"
                              Condition="'$(VlcWindowsX64Enabled)' == 'true'" />
    <VlcWindowsX86IncludeFiles Include="@(PclVlcPlaybackModule)"
                              Condition="'$(VlcWindowsX86Enabled)' == 'true'" />
    <VlcWindowsArm64IncludeFiles Include="@(PclVlcPlaybackModule)"
                                Condition="'$(VlcWindowsArm64Enabled)' == 'true'" />
  </ItemGroup>
</Project>
