<Grid x:Class="PCL.Desktop.Controls.Legacy.MyRadioBox"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      MinWidth="20" x:Name="PanBack" MinHeight="20"
      Background="{StaticResource ColorBrushSemiTransparent}"
      Focusable="True">
    <TextBlock IsHitTestVisible="False" x:Name="LabText" FontSize="13" Padding="0" Margin="26,0,0,0"
               Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Left" VerticalAlignment="Center" />
    <!--
      Fixed indicator host so the outer ring and inner pie stay geometrically centered.
      Scaling Width/Height with left-margin math drifts the pie after animation.
    -->
    <Grid x:Name="PanIndicator" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
          IsHitTestVisible="False">
        <Ellipse x:Name="ShapeBorder" StrokeThickness="1" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Width="18" Height="18" Stroke="{DynamicResource ColorBrush1}"
                 Fill="{DynamicResource ColorBrushHalfWhite}" />
        <Ellipse x:Name="ShapeDot" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="{DynamicResource ColorBrush1}" Width="0" Height="0"
                 StrokeThickness="0" />
    </Grid>
</Grid>
