<local:MyCard x:Class="PCL.Desktop.Controls.Legacy.MySearchBar"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="using:PCL.Desktop.Controls.Legacy"
              Height="44">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="34" Padding="12,0,0,0">
            <Path Width="16" Height="16" IsHitTestVisible="False"
                  Fill="{DynamicResource ColorBrush1}" Stretch="Uniform"
                  Data="M675.9168 242.816C556.3008 123.2 362.4448 123.2 242.8288 242.816 123.2128 362.432 123.2128 556.288 242.8288 675.904 362.4448 795.52 556.3008 795.52 675.9168 675.904 795.5328 556.288 795.5328 362.432 675.9168 242.816L675.9168 242.816ZM1000.7168 892.48C1030.6048 922.368 1030.6048 970.816 1000.7168 1000.704 970.8288 1030.656 922.3808 1030.656 892.4288 1000.704L730.0608 838.336C728.1408 836.416 727.4368 833.92 725.7728 831.872 546.3168 960.448 295.7568 945.408 134.5408 784.192-44.8512 604.8-44.8512 313.92 134.5408 134.528 313.9328-44.864 604.8128-44.864 784.2048 134.528 945.4208 295.744 960.4608 546.304 831.8848 725.76 833.9328 727.424 836.4288 728.128 838.3488 730.048L1000.7168 892.48Z"
                  HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Border>
        <local:MyTextBox Grid.Column="1" x:Name="TextBox" HasBackground="False" BorderThickness="0" Padding="0"
                         MaxLength="50" FontSize="13.5" VerticalContentAlignment="Center"
                         TextChanged="Text_TextChanged" />
        <Border Grid.Column="2" Width="36" Padding="0,0,8,0">
            <local:MyIconButton x:Name="BtnClear" Click="BtnClear_Click" IsHitTestVisible="False" Opacity="0"
                                Width="28" Height="28" LogoScale="0.75"
                                Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Theme="Black" />
        </Border>
    </Grid>
</local:MyCard>