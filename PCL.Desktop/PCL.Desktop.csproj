<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Managed assembly identity (avares://, InternalsVisibleTo, RootNamespace). -->
    <AssemblyName>PCL.Desktop</AssemblyName>
    <!-- Product host binary file name only (exe/apphost/AOT); not the assembly name. -->
    <ProductBinaryName Condition="'$(ProductBinaryName)' == ''">PCL-N-Edition</ProductBinaryName>
    <RootNamespace>PCL.Desktop</RootNamespace>
    <Description>PCL N cross-platform Avalonia desktop shell</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- NativeAOT production policy: optimize the launcher for responsiveness.
         Framework MIBC PGO is intentionally disabled: speed optimization remains enabled,
         while avoiding the large framework-profile contribution to executable
         size. Hot code performs runtime ISA dispatch instead of raising the
         minimum CPU required by a public RID artifact.
         Do not use IlcInstructionSet=native for public artifacts because the
         runner CPU is not the minimum CPU supported by each RID. -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcPgoOptimize>false</IlcPgoOptimize>
    <UseSizeOptimizedLinq>false</UseSizeOptimizedLinq>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- HotSpot switches native thread contexts during JNI_CreateJavaVM. Windows CET shadow stacks
         reject those continuations and terminate the isolated host with FAST_FAIL_INVALID_CONTROL_STACK. -->
    <CETCompat Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</CETCompat>
    <!-- Whether the embedded CoreCLR plugin sidecar carries its runtime.
         The desktop host itself is always self-contained NativeAOT in releases. -->
    <PclRuntimeVariant Condition="'$(PclRuntimeVariant)' == ''">SelfContained</PclRuntimeVariant>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <PclHpatchzPath Condition="'$(PclHpatchzPath)' != ''">$([System.IO.Path]::GetFullPath('$(PclHpatchzPath)'))</PclHpatchzPath>
    <!-- Opaque CoreCLR sidecar zip embedded into the host single-file binary (not in-process plugin IL). -->
    <PclPluginSidecarZipPath Condition="'$(PclPluginSidecarZipPath)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_PLUGIN_SIDECAR_ZIP'))</PclPluginSidecarZipPath>
    <PclPluginSidecarZipPath Condition="'$(PclPluginSidecarZipPath)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginSidecarZipPath)'))</PclPluginSidecarZipPath>
    <PclNativeRuntimeZipPath Condition="'$(PclNativeRuntimeZipPath)' != ''">$([System.IO.Path]::GetFullPath('$(PclNativeRuntimeZipPath)'))</PclNativeRuntimeZipPath>

    <!-- CI secret pre-write (PCL_WRITE_SECRET=1 embeds values into PclEmbeddedSecrets). -->
    <PclWriteSecret Condition="'$(PclWriteSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_WRITE_SECRET'))</PclWriteSecret>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_MS_CLIENT_ID'))</PclMsClientId>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('MS_CLIENT_ID'))</PclMsClientId>
    <PclLittleSkinClientId Condition="'$(PclLittleSkinClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_CLIENT_ID'))</PclLittleSkinClientId>
    <PclLittleSkinClientSecret Condition="'$(PclLittleSkinClientSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_CLIENT_SECRET'))</PclLittleSkinClientSecret>
    <PclLittleSkinRedirectUri Condition="'$(PclLittleSkinRedirectUri)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_REDIRECT_URI'))</PclLittleSkinRedirectUri>
    <PclCurseForgeApiKey Condition="'$(PclCurseForgeApiKey)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_CURSEFORGE_API_KEY'))</PclCurseForgeApiKey>
    <PclSentryDsn Condition="'$(PclSentryDsn)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_SENTRY_DSN'))</PclSentryDsn>
    <PclSentryEssentialDsn Condition="'$(PclSentryEssentialDsn)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_SENTRY_ESSENTIAL_DSN'))</PclSentryEssentialDsn>
    <PclPostHogProjectToken Condition="'$(PclPostHogProjectToken)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_POSTHOG_PROJECT_TOKEN'))</PclPostHogProjectToken>
    <PclPostHogHost Condition="'$(PclPostHogHost)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_POSTHOG_HOST'))</PclPostHogHost>
    <PclNaidClientId Condition="'$(PclNaidClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_ID'))</PclNaidClientId>
    <PclNaidClientSecret Condition="'$(PclNaidClientSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_SECRET'))</PclNaidClientSecret>
    <PclLinkServerRoot Condition="'$(PclLinkServerRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LINK_SERVER_ROOT'))</PclLinkServerRoot>
    <PclLobbyDefaultSecret Condition="'$(PclLobbyDefaultSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LOBBY_DEFAULT_SECRET'))</PclLobbyDefaultSecret>
    <PclGithubSha Condition="'$(PclGithubSha)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_GITHUB_SHA'))</PclGithubSha>
  </PropertyGroup>
  <!--
    VideoLAN.LibVLC.Windows enables x64, x86, and ARM64 for AnyCPU projects by
    default. RID-specific publishes only need the matching native distribution;
    including all three adds hundreds of megabytes before single-file compression.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>true</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PCL.Desktop.Test" />
    <!-- Plugin UI types (MyPageRight, etc.) when running inside sidecar process only. -->
    <InternalsVisibleTo Include="PCL.Plugin" />
    <InternalsVisibleTo Include="PCL.Plugin.Sidecar" />
    <InternalsVisibleTo Include="PCL.Plugin.Test" />
  </ItemGroup>
  <Import Project="LibVlcPlaybackModules.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PclRuntimeVariant</_Parameter1>
      <_Parameter2>$(PclRuntimeVariant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InformationalVersion" />
    <CompilerVisibleProperty Include="Version" />
    <CompilerVisibleProperty Include="SourceRevisionId" />
    <CompilerVisibleProperty Include="PclRuntimeVariant" />
    <CompilerVisibleProperty Include="PclIncludesPlugin" />
    <CompilerVisibleProperty Include="PclWriteSecret" />
    <CompilerVisibleProperty Include="PclMsClientId" />
    <CompilerVisibleProperty Include="PclLittleSkinClientId" />
    <CompilerVisibleProperty Include="PclLittleSkinClientSecret" />
    <CompilerVisibleProperty Include="PclLittleSkinRedirectUri" />
    <CompilerVisibleProperty Include="PclCurseForgeApiKey" />
    <CompilerVisibleProperty Include="PclSentryDsn" />
    <CompilerVisibleProperty Include="PclSentryEssentialDsn" />
    <CompilerVisibleProperty Include="PclPostHogProjectToken" />
    <CompilerVisibleProperty Include="PclPostHogHost" />
    <CompilerVisibleProperty Include="PclNaidClientId" />
    <CompilerVisibleProperty Include="PclNaidClientSecret" />
    <CompilerVisibleProperty Include="PclLinkServerRoot" />
    <CompilerVisibleProperty Include="PclLobbyDefaultSecret" />
    <CompilerVisibleProperty Include="PclGithubSha" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <PackageReference Include="Sentry" Version="6.8.0" />
    <ProjectReference Include="../external/Jvm.NET/src/Jvm.NET/Jvm.NET.csproj" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <!-- This package only ships an x86-64 Mach-O binary; never embed it in an ARM64 app. -->
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                      Condition="'$(RuntimeIdentifier)' == 'osx-x64' OR ('$(RuntimeIdentifier)' == '' AND $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').StartsWith('osx-x64')))" />
    <!-- Linux native runtime dependencies for SkiaSharp and HarfBuzzSharp -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"
                      Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3"
                      Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
    <PackageReference Include="Wacton.Unicolour" Version="6.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Localization/zh-CN.xaml">
      <LogicalName>PCL.Desktop.Localization.zh-CN.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization/zh-TW.xaml">
      <LogicalName>PCL.Desktop.Localization.zh-TW.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization/en-US.xaml">
      <LogicalName>PCL.Desktop.Localization.en-US.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets/mcmod.buf">
      <LogicalName>PCL.Desktop.Assets.mcmod.buf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="metadata.json">
      <LogicalName>PCL.Desktop.metadata.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Legal/terms.md">
      <LogicalName>PCL.Desktop.Legal.terms.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Legal/privacy.md">
      <LogicalName>PCL.Desktop.Legal.privacy.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclHpatchzPath)"
                      Condition="'$(PclHpatchzPath)' != '' and Exists('$(PclHpatchzPath)')">
      <LogicalName>PCL.Desktop.Embedded.hpatchz</LogicalName>
    </EmbeddedResource>
    <!-- Multi-file sidecar payload: extracted at runtime into {data}/runtime/sidecar/{hash}/ -->
    <EmbeddedResource Include="$(PclPluginSidecarZipPath)"
                      Condition="'$(PclPluginSidecarZipPath)' != '' and Exists('$(PclPluginSidecarZipPath)')">
      <LogicalName>PCL.Desktop.Embedded.PluginSidecar.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclNativeRuntimeZipPath)"
                      Condition="'$(PclNativeRuntimeZipPath)' != '' and Exists('$(PclNativeRuntimeZipPath)')">
      <LogicalName>PCL.Desktop.Embedded.NativeRuntime.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Undefine host publish flags so netstandard analyzer is not published as AOT/R2R. -->
    <ProjectReference Include="../PCL.Desktop.SourceGenerators/PCL.Desktop.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot;PublishTrimmed;PublishReadyToRun;PublishProtocol" />
    <ProjectReference Include="../PCL.Application/PCL.Application.csproj" />
    <ProjectReference Include="../PCL.Platform/PCL.Platform.csproj" />
    <ProjectReference Include="../PCL.UI.Abstractions/PCL.UI.Abstractions.csproj" />
    <ProjectReference Include="../PCL.UI.Next/PCL.UI.Next.csproj" />
    <ProjectReference Include="../PCL.UI.Next.Backend.Avalonia/PCL.UI.Next.Backend.Avalonia.csproj" />
  </ItemGroup>
  <Import Project="GenerateEmbeddedSecrets.targets" />
  <!--
    Source-overlay plugin inject: after scripts/apply-plugin-overlay.ps1 pulls PCL.Plugin
    and rewrites host hooks, build with -p:PclWithPlugin=true to compile plugin sources
    into the desktop host (no embedded plugin IL).
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\PCL.Plugin\host-overlay\msbuild\PclPlugin.overlay.targets"
          Condition="'$(PclWithPlugin)' == 'true' and Exists('$(MSBuildThisFileDirectory)..\PCL.Plugin\host-overlay\msbuild\PclPlugin.overlay.targets')" />

  <!--
    Keep AssemblyName=PCL.Desktop for managed identity (avares://PCL.Desktop/..., IVT, *.dll).
    Rename only the native apphost / AOT host binary to ProductBinaryName (PCL-N-Edition[.exe]).
    Do NOT rename TargetExt (.dll) — that would change the assembly identity on disk.
  -->
  <Target Name="RenameProductHostBinary"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(ProductBinaryName)' != '' and '$(ProductBinaryName)' != '$(AssemblyName)'">
    <PropertyGroup>
      <!-- TargetExt is .dll; the launchable host is AssemblyName.exe (Windows) or AssemblyName (Unix). -->
      <_HostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(AssemblyName).exe</_HostFile>
      <_HostFile Condition="'$(_HostFile)' == ''">$(AssemblyName)</_HostFile>
      <_ProductHostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(ProductBinaryName).exe</_ProductHostFile>
      <_ProductHostFile Condition="'$(_ProductHostFile)' == ''">$(ProductBinaryName)</_ProductHostFile>
      <_SrcHost>$(TargetDir)$(_HostFile)</_SrcHost>
      <_DstHost>$(TargetDir)$(_ProductHostFile)</_DstHost>
    </PropertyGroup>
    <Copy SourceFiles="$(_SrcHost)"
          DestinationFiles="$(_DstHost)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(_SrcHost)')" />
    <Delete Files="$(_SrcHost)"
            Condition="Exists('$(_SrcHost)') and Exists('$(_DstHost)')" />
  </Target>

  <Target Name="RenamePublishedProductHostBinary"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(ProductBinaryName)' != '' and '$(ProductBinaryName)' != '$(AssemblyName)' and '$(PublishDir)' != ''">
    <PropertyGroup>
      <_PubDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_PubDir>
      <_HostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(AssemblyName).exe</_HostFile>
      <_HostFile Condition="'$(_HostFile)' == ''">$(AssemblyName)</_HostFile>
      <_ProductHostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(ProductBinaryName).exe</_ProductHostFile>
      <_ProductHostFile Condition="'$(_ProductHostFile)' == ''">$(ProductBinaryName)</_ProductHostFile>
      <_SrcHost>$(_PubDir)$(_HostFile)</_SrcHost>
      <_DstHost>$(_PubDir)$(_ProductHostFile)</_DstHost>
    </PropertyGroup>
    <Copy SourceFiles="$(_SrcHost)"
          DestinationFiles="$(_DstHost)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(_SrcHost)')" />
    <Delete Files="$(_SrcHost)"
            Condition="Exists('$(_SrcHost)') and Exists('$(_DstHost)')" />
  </Target>

  <!-- Ship CoreCLR plugin sidecar next to the host so splash warm-up can find it. -->
  <PropertyGroup>
    <PclPluginSidecarProject Condition="'$(PclPluginSidecarProject)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\PCL.Plugin\PCL.Plugin.Sidecar\PCL.Plugin.Sidecar.csproj'))</PclPluginSidecarProject>
    <PclPluginSidecarOutDir Condition="'$(PclPluginSidecarOutDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\PCL.Plugin\PCL.Plugin.Sidecar\bin\$(Configuration)\net10.0\'))</PclPluginSidecarOutDir>
  </PropertyGroup>
  <Target Name="CopyPluginSidecarToOutput"
          AfterTargets="Build"
          Condition="Exists('$(PclPluginSidecarProject)')">
    <MakeDir Directories="$(TargetDir)sidecar" />
    <ItemGroup>
      <_SidecarFiles Include="$(PclPluginSidecarOutDir)**\*.*"
                     Condition="Exists('$(PclPluginSidecarOutDir)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_SidecarFiles)"
          DestinationFiles="@(_SidecarFiles->'$(TargetDir)sidecar\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_SidecarFiles)' != ''" />
    <Message Importance="high"
             Text="Plugin sidecar not built yet under $(PclPluginSidecarOutDir); host will try dev path or run without plugins."
             Condition="'@(_SidecarFiles)' == ''" />
  </Target>
</Project>
