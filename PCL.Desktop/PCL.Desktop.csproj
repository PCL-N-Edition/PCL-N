<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>PCL.Desktop</AssemblyName>
    <RootNamespace>PCL.Desktop</RootNamespace>
    <Description>PCL N cross-platform Avalonia desktop shell</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- HotSpot switches native thread contexts during JNI_CreateJavaVM. Windows CET shadow stacks
         reject those continuations and terminate the isolated host with FAST_FAIL_INVALID_CONTROL_STACK. -->
    <CETCompat Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</CETCompat>
    <PclRuntimeVariant Condition="'$(PclRuntimeVariant)' == ''">SelfContained</PclRuntimeVariant>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <PclHpatchzPath Condition="'$(PclHpatchzPath)' != ''">$([System.IO.Path]::GetFullPath('$(PclHpatchzPath)'))</PclHpatchzPath>

    <!-- CI secret pre-write (PCL_WRITE_SECRET=1 embeds values into PclEmbeddedSecrets). -->
    <PclWriteSecret Condition="'$(PclWriteSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_WRITE_SECRET'))</PclWriteSecret>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_MS_CLIENT_ID'))</PclMsClientId>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('MS_CLIENT_ID'))</PclMsClientId>
    <PclLittleSkinClientId Condition="'$(PclLittleSkinClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_CLIENT_ID'))</PclLittleSkinClientId>
    <PclLittleSkinClientSecret Condition="'$(PclLittleSkinClientSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_CLIENT_SECRET'))</PclLittleSkinClientSecret>
    <PclLittleSkinRedirectUri Condition="'$(PclLittleSkinRedirectUri)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LITTLESKIN_REDIRECT_URI'))</PclLittleSkinRedirectUri>
    <PclCurseForgeApiKey Condition="'$(PclCurseForgeApiKey)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_CURSEFORGE_API_KEY'))</PclCurseForgeApiKey>
    <PclSentryDsn Condition="'$(PclSentryDsn)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_SENTRY_DSN'))</PclSentryDsn>
    <PclNaidClientId Condition="'$(PclNaidClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_ID'))</PclNaidClientId>
    <PclNaidClientSecret Condition="'$(PclNaidClientSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_SECRET'))</PclNaidClientSecret>
    <PclLinkServerRoot Condition="'$(PclLinkServerRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LINK_SERVER_ROOT'))</PclLinkServerRoot>
    <PclLobbyDefaultSecret Condition="'$(PclLobbyDefaultSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LOBBY_DEFAULT_SECRET'))</PclLobbyDefaultSecret>
    <PclGithubSha Condition="'$(PclGithubSha)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_GITHUB_SHA'))</PclGithubSha>
  </PropertyGroup>
  <!--
    VideoLAN.LibVLC.Windows enables x64, x86, and ARM64 for AnyCPU projects by
    default. RID-specific publishes only need the matching native distribution;
    including all three adds hundreds of megabytes before single-file compression.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>true</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PCL.Desktop.Test" />
  </ItemGroup>
  <Import Project="LibVlcPlaybackModules.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PclRuntimeVariant</_Parameter1>
      <_Parameter2>$(PclRuntimeVariant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InformationalVersion" />
    <CompilerVisibleProperty Include="Version" />
    <CompilerVisibleProperty Include="SourceRevisionId" />
    <CompilerVisibleProperty Include="PclRuntimeVariant" />
    <CompilerVisibleProperty Include="PclWriteSecret" />
    <CompilerVisibleProperty Include="PclMsClientId" />
    <CompilerVisibleProperty Include="PclLittleSkinClientId" />
    <CompilerVisibleProperty Include="PclLittleSkinClientSecret" />
    <CompilerVisibleProperty Include="PclLittleSkinRedirectUri" />
    <CompilerVisibleProperty Include="PclCurseForgeApiKey" />
    <CompilerVisibleProperty Include="PclSentryDsn" />
    <CompilerVisibleProperty Include="PclNaidClientId" />
    <CompilerVisibleProperty Include="PclNaidClientSecret" />
    <CompilerVisibleProperty Include="PclLinkServerRoot" />
    <CompilerVisibleProperty Include="PclLobbyDefaultSecret" />
    <CompilerVisibleProperty Include="PclGithubSha" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <ProjectReference Include="../external/Jvm.NET/src/Jvm.NET/Jvm.NET.csproj" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <!-- This package only ships an x86-64 Mach-O binary; never embed it in an ARM64 app. -->
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                      Condition="'$(RuntimeIdentifier)' == 'osx-x64' OR ('$(RuntimeIdentifier)' == '' AND $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').StartsWith('osx-x64')))" />
    <PackageReference Include="Wacton.Unicolour" Version="6.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Localization/zh-CN.xaml">
      <LogicalName>PCL.Desktop.Localization.zh-CN.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization/zh-TW.xaml">
      <LogicalName>PCL.Desktop.Localization.zh-TW.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization/en-US.xaml">
      <LogicalName>PCL.Desktop.Localization.en-US.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets/mcmod.buf">
      <LogicalName>PCL.Desktop.Assets.mcmod.buf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="metadata.json">
      <LogicalName>PCL.Desktop.metadata.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclHpatchzPath)"
                      Condition="'$(PclHpatchzPath)' != '' and Exists('$(PclHpatchzPath)')">
      <LogicalName>PCL.Desktop.Embedded.hpatchz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Undefine host publish flags so netstandard analyzer is not published as AOT/R2R. -->
    <ProjectReference Include="../PCL.Desktop.SourceGenerators/PCL.Desktop.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot;PublishTrimmed;PublishReadyToRun;PublishProtocol" />
    <ProjectReference Include="../PCL.Application/PCL.Application.csproj" />
    <ProjectReference Include="../PCL.Platform/PCL.Platform.csproj" />
    <ProjectReference Include="../PCL.UI.Abstractions/PCL.UI.Abstractions.csproj" />
  </ItemGroup>
  <Import Project="GenerateEmbeddedSecrets.targets" />
</Project>
