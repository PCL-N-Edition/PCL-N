<Page xmlns="https://pcln.dev/pxml/2026" Key="LaunchingPage" Label="正在启动">
  <!--
    The launching card, replicated from the legacy launching dialog and presented as its own
    navigation page. The card paints its full bounds (no container padding — the renderer
    paints only the content rect, so spacing lives on child margins), and the vertical budget
    is trimmed to fit the smallest window. The trivia hint remains part of launch progress;
    Java acquisition and other modal decisions use the shared in-window dialog.
  -->
  <ContentHost Key="LaunchingHost">
    <StackPanel Orientation="Vertical" Key="LaunchingCard" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
      <Image Key="LaunchingIcon" Source="lucide/loader-circle" Width="40" Height="40"
             HorizontalAlignment="Center" Margin="32,24,32,0" />
      <Text Key="LaunchingTitle" Content="{state launch.launching.title}" Height="30"
            HorizontalAlignment="Center" Margin="32,12,32,0" />
      <Text Key="LaunchingName" Content="{state launch.launching.name}" Height="20"
            HorizontalAlignment="Center" Margin="32,4,32,0" />
      <StackPanel Orientation="Vertical" Key="LaunchingBody" Margin="32,14,32,0">
        <ContentHost Key="LaunchProgressTrack" Height="4">
          <Progress Key="LaunchProgressFill" Value="{state minecraft.launch.progress}" Height="4"
                    Label="启动进度条" />
        </ContentHost>
        <StackPanel Orientation="Horizontal" Key="LaunchingStageRow" Margin="0,12,0,0">
          <Text Key="LaunchingStageLabel" Content="当前步骤" Width="64" Height="16" />
          <Text Key="LaunchingStageValue" Content="{state launch.launching.stage}" Height="16" Weight="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Key="LaunchingMethodRow" Margin="0,6,0,0">
          <Text Key="LaunchingMethodLabel" Content="登录方式" Width="64" Height="16" />
          <Text Key="LaunchingMethodValue" Content="{state launch.launching.method}" Height="16" Weight="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Key="LaunchingPercentRow" Margin="0,6,0,0">
          <Text Key="LaunchingPercentLabel" Content="启动进度" Width="64" Height="16" />
          <Text Key="LaunchingPercentValue" Content="{state launch.launching.percent}" Height="16" Weight="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Key="LaunchingSpeedRow" Margin="0,6,0,0"
                    IsVisible="{state launch.launching.speed-visible}">
          <Text Key="LaunchingSpeedLabel" Content="下载速度" Width="64" Height="16" />
          <Text Key="LaunchingSpeedValue" Content="{state launch.launching.speed}" Height="16" Weight="1" />
        </StackPanel>
        <ContentHost Key="LaunchingHintBox" Height="84" Margin="0,12,0,0">
          <StackPanel Orientation="Vertical" Spacing="4" Margin="12,12,12,12">
            <Text Key="LaunchingHintTitle" Content="启动贴士" Height="16" HorizontalAlignment="Center" />
            <Text Key="LaunchingHintValue" Content="{state launch.launching.hint}" Height="32"
                  HorizontalAlignment="Center" />
          </StackPanel>
        </ContentHost>
      </StackPanel>
      <Button Key="LaunchingCancelButton" Label="{state launch.launching.cancel-label}"
              Content="{state launch.launching.cancel-label}" Command="ui.launch.cancel"
              Height="40" Margin="32,16,32,16" />
    </StackPanel>
  </ContentHost>
</Page>
