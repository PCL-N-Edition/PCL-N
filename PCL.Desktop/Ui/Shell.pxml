<Shell xmlns="https://pcln.dev/pxml/2026" Label="Nexa Launcher">
  <TitleBar Height="52">
    <Text Content="Nexa Launcher" Margin="20,0,0,0" Width="240" />
  </TitleBar>
  <StackPanel Orientation="Horizontal" StretchLastChild="true">
    <Navigation Width="48" StretchLastChild="true">
      <NavigationItem Label="启动" Content="启动" Icon="lucide/play" Command="ui.navigation.launch" />
      <NavigationItem Label="安装" Content="安装" Icon="lucide/package-plus" Command="ui.navigation.download" />
      <NavigationItem Label="资源" Content="资源" Icon="lucide/blocks" Command="ui.navigation.community" />
      <NavigationItem Label="设置" Content="设置" Icon="lucide/settings" Command="ui.navigation.settings" />
    </Navigation>
    <ContentHost Padding="28,24,28,24" />
  </StackPanel>
</Shell>
