<Button xmlns="https://pcln.dev/pxml/2026" Key="AccountRow" Height="52"
        Command="ui.account.select">
  <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,6,12,6">
    <Image Key="ProfileAvatar" Source="lucide/user" Width="28" Height="28" VerticalAlignment="Center" />
    <StackPanel Orientation="Vertical" Spacing="2" Weight="1">
      <Text Key="ProfileName" Content="" Height="20" />
      <Text Key="ProfileDetail" Content="" Height="18" />
    </StackPanel>
  </StackPanel>
</Button>
