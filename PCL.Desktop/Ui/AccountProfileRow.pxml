<Button xmlns="https://pcln.dev/pxml/2026" Key="AccountRow" Height="56"
        Command="ui.account.select">
  <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,8,10,8">
    <Image Key="ProfileAvatar" Source="pcl/avatar/steve" Width="40" Height="40" VerticalAlignment="Center" />
    <StackPanel Orientation="Vertical" Spacing="2" Weight="1" VerticalAlignment="Center">
      <Text Key="ProfileName" Content="" Height="20" />
      <Text Key="ProfileDetail" Content="" Height="16" />
    </StackPanel>
    <StackPanel Width="16" Height="16" VerticalAlignment="Center">
      <Image Key="ProfileCheck" Label="当前档案" Source="lucide/check" Width="16" Height="16" />
    </StackPanel>
  </StackPanel>
</Button>
