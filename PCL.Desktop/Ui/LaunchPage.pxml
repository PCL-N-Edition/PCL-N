<Page xmlns="https://pcln.dev/pxml/2026" Key="LaunchPage" Label="启动页">
  <StackPanel Orientation="Horizontal" Spacing="16">
    <StackPanel Orientation="Vertical" Weight="0.92" MinWidth="240" MaxWidth="360" Key="CardAccount">
      <StackPanel Orientation="Vertical" Weight="1" Margin="20,18,20,18" Key="AccountContent">
        <StackPanel Orientation="Horizontal" Spacing="8" Height="32"
                    Margin="0,0,0,12" Key="AccountHeaderRow">
          <Button Key="AccountBack" Label="返回账户" Icon="lucide/arrow-left" Width="32" Height="32"
                  Command="ui.account.back" IsVisible="{state launch.account.back-visible}" />
          <Text Key="AccountHeader" Content="{state launch.account.title}" Weight="1" VerticalAlignment="Center"
                TransitionKey="{state launch.account.title}" TransitionOffsetY="6" />
          <Button Key="AccountAdd" Label="添加账户" Content="添加" Icon="lucide/plus" Width="72" Height="32" VerticalAlignment="Center"
                  Command="ui.account.add" IsVisible="{state launch.account.add-visible}" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Weight="1" MinHeight="160" Key="AccountBody">
          <StackPanel Orientation="Vertical" Weight="1" Key="AccountSelected"
                      IsVisible="{state launch.account.selected-visible}">
            <StackPanel Key="AccountIdentity" Orientation="Vertical" Weight="1" VerticalAlignment="Center">
              <StackPanel Key="AccountAvatarSurface" Width="88" Height="88" HorizontalAlignment="Center">
                <Image Key="AccountAvatar" Label="账户头像" Source="pcl/avatar/steve" Width="72" Height="72"
                       Weight="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </StackPanel>
              <Text Key="AccountName" Content="{state launch.profile.name}" Height="30" Margin="0,16,0,0" />
              <Text Key="AccountKind" Content="{state launch.profile.kind}" Height="20" Margin="0,4,0,0" />
              <StackPanel Key="AccountActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="End" Margin="0,20,0,0">
                <Button Key="AccountSwitch" Label="切换档案" Content="切换档案" Icon="lucide/arrow-right-left"
                        Command="ui.account.switch" Height="36" Width="110" />
                <Button Key="AccountWardrobe" Label="更衣橱" Content="更衣橱" Icon="lucide/shirt"
                        Command="ui.account.wardrobe" Height="36" Width="96" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Vertical" Weight="1" Spacing="10" Key="AccountPicker"
                      IsVisible="{state launch.account.roster-visible}">
            <Text Key="AccountHint" Content="{state launch.account.hint}" Height="36"
                  IsVisible="{state launch.account.hint-visible}" />
            <StackPanel Orientation="Vertical" Weight="1" MaxHeight="300" Spacing="6" Scroll="true" Key="AccountRows" />
            <Button Key="AccountImport" Label="导入旧档案" Content="导入旧档案" Height="34" Command="ui.account.import" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Vertical" Spacing="12" Weight="1.35" MinWidth="280" Key="RightColumn">
      <StackPanel Orientation="Vertical" Key="CardVersion">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="16,14,16,14" Key="VersionContent">
          <StackPanel Orientation="Horizontal" StretchLastChild="true" Key="VersionHeaderRow">
            <Text Key="VersionHeader" Content="版本" VerticalAlignment="Center" />
            <Button Key="InstanceListButton" Label="版本列表" Content="版本列表" Command="ui.launch.instances"
                    Icon="lucide/menu" Width="98" Height="36" HorizontalAlignment="End" />
          </StackPanel>
          <StackPanel Orientation="Vertical" Key="InstanceRow">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,10,12,10" Key="InstanceRowContent">
              <Text Key="VersionName" Content="{state launch.instance.summary}" Height="30"
                    Weight="1" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="End" Key="VersionActions">
                <Button Key="InstanceModify" Label="修改" Content="修改" Command="ui.launch.modify"
                        Icon="lucide/wrench" Width="72" Height="36" Clickable="{state launch.instance.available}" />
                <Button Key="InstanceSettings" Label="设置" Content="设置" Command="ui.launch.settings"
                        Icon="lucide/settings" Width="72" Height="36" Clickable="{state launch.instance.available}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Key="LaunchButton" Label="{state launch.action.label}"
                  Content="{state launch.action.label}" Command="ui.launch.primary" Height="44"
                  Clickable="{state launch.action.enabled}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Vertical" Weight="1" Key="CardAbout">
        <StackPanel Orientation="Horizontal" Spacing="8" Weight="1" Margin="18,14,10,14" Key="AboutContent">
          <StackPanel Orientation="Vertical" Spacing="8" Weight="1">
            <VerticalPager Key="LaunchWidgetPager" Label="启动页信息卡片，可使用上下方向键翻页" Weight="1">
              <StackPanel Orientation="Vertical" Spacing="8" Key="AboutCopy">
                <Text Key="AboutTitle" Content="关于 PCL N Edition" Height="24" />
                <Text Key="AboutMessage" Content="PCL N Edition 与官方 PCL 项目独立维护，部分功能与行为可能有所不同。" Height="56" />
              </StackPanel>
              <Button Key="TriviaPage" Label="你知道吗？点击换一条" Command="ui.launch.hint.refresh">
                <StackPanel Orientation="Vertical" Spacing="8">
                  <Text Key="TriviaTitle" Content="你知道吗？" Height="24" />
                  <Text Key="TriviaMessage" Content="{state launch.widget.hint}" Height="56"
                        TransitionKey="{state launch.widget.hint}" TransitionOffsetY="6" />
                </StackPanel>
              </Button>
              <StackPanel Key="EchoPage" Orientation="Vertical" Spacing="8">
                <Text Key="EchoTitle" Content="回声洞" Height="24" />
                <Text Key="EchoMessage" Content="请等待本功能上线，到时你可以前往官网上投稿~" Height="56" />
              </StackPanel>
            </VerticalPager>
          </StackPanel>
          <StackPanel Orientation="Vertical" Key="WidgetIndicators" Width="6" Spacing="8" VerticalAlignment="Center">
            <Button Key="WidgetAboutIndicator" Label="{state launch.widget.about-label}" Command="ui.launch.widget.about" Width="6" Height="16">
              <StackPanel Key="WidgetAboutDot" Width="6" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Key="WidgetTriviaIndicator" Label="{state launch.widget.trivia-label}" Command="ui.launch.widget.trivia" Width="6" Height="6">
              <StackPanel Key="WidgetTriviaDot" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Key="WidgetEchoIndicator" Label="{state launch.widget.echo-label}" Command="ui.launch.widget.echo" Width="6" Height="6">
              <StackPanel Key="WidgetEchoDot" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Page>
