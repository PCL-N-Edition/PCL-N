<Page xmlns="https://pcln.dev/pxml/2026" Key="LaunchPage" Label="启动页">
  <StackPanel Orientation="Horizontal" Spacing="16">
    <StackPanel Orientation="Vertical" Weight="0.92" MinWidth="240" MaxWidth="360" Key="CardAccount">
      <StackPanel Orientation="Vertical" Weight="1" Margin="20,18,20,18" Key="AccountContent">
        <StackPanel Orientation="Horizontal" Spacing="8" StretchLastChild="true"
                    Margin="0,0,0,12" Key="AccountHeaderRow">
          <Text Key="AccountHeader" Content="账户" Height="16" />
          <StackPanel Orientation="Vertical" HorizontalAlignment="End" Key="AccountBadge">
            <Text Key="AccountBadgeText" Content="实验" Height="12" Margin="7,2,7,2" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" Weight="1" MinHeight="160" Key="AccountBody">
          <Text Key="AccountName" Content="{state launch.profile.name}" />
        </StackPanel>
        <Text Key="AccountSummary" Content="{state launch.profile.summary}"
              Height="18" Margin="0,12,0,0" />
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Vertical" Spacing="12" Weight="1.35" MinWidth="280" Key="RightColumn">
      <StackPanel Orientation="Vertical" Key="CardVersion">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="16,14,16,14" Key="VersionContent">
          <StackPanel Orientation="Horizontal" StretchLastChild="true" Key="VersionHeaderRow">
            <Text Key="VersionHeader" Content="版本" VerticalAlignment="Center" />
            <Button Key="InstanceListButton" Label="版本列表" Content="≡" Command="ui.launch.instances"
                    Width="28" Height="28" HorizontalAlignment="End" />
          </StackPanel>
          <StackPanel Orientation="Vertical" Key="InstanceRow">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10,12,10" Key="InstanceRowContent">
              <StackPanel Orientation="Vertical" Spacing="1" Weight="1" VerticalAlignment="Center"
                          Key="InstanceCopy">
                <Text Key="VersionName" Content="{state launch.instance.summary}" Height="20" />
                <Text Key="VersionAction" Content="{state launch.instance.detail}" Height="15" />
              </StackPanel>
              <StackPanel Orientation="Vertical" StretchLastChild="true" Width="26" Height="26"
                          HorizontalAlignment="End" VerticalAlignment="Center" Key="InstanceChevron">
                <Text Key="InstanceChevronText" Content="›"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Key="LaunchButton" Label="{state launch.action.label}"
                  Content="{state launch.action.label}" Command="ui.launch.primary" Height="44" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Vertical" Weight="1" Key="CardAbout">
        <StackPanel Orientation="Vertical" Spacing="8" Weight="1" Margin="18,14,32,14" Key="AboutContent">
          <Text Key="AboutTitle" Content="关于 PCL N Edition" Height="28"
                VerticalAlignment="Center" />
          <StackPanel Orientation="Vertical" Spacing="8" Weight="1" Key="AboutCopy">
            <Text Key="AboutMessage" Content="PCL N Edition 与官方 PCL 项目独立维护，部分功能与行为可能有所不同。"
                  Height="20" />
            <Text Key="LaunchStatus" Content="{state launch.status}" Height="18" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Page>
