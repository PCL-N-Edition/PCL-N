<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
        x:Class="PCL.Desktop.Views.FirstRun.FirstRunWizardWindow"
        x:Name="WindFirstRun"
        Width="860"
        Height="520"
        MinWidth="860"
        MinHeight="520"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="False"
        Title="PCL N Edition"
        Icon="avares://PCL.Desktop/Assets/icon.png"
        Background="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent">

    <!--
      Window stays full-size and never moves.
      Expand is done by growing PanBubble (centered circle → rounded card).
    -->
    <Grid x:Name="PanRoot"
          Background="Transparent"
          ClipToBounds="False">
        <Border x:Name="PanBubble"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="136"
                Height="136"
                CornerRadius="68"
                Background="{DynamicResource ColorBrushBackground}"
                BoxShadow="0 0 0 0 #00000000"
                ClipToBounds="True">
            <Grid x:Name="PanStage">
                <!-- Page 1: splash-handoff icon + welcome -->
                <Grid x:Name="PageWelcome"
                      IsHitTestVisible="True">
                    <Image x:Name="HeroIcon"
                           Source="avares://PCL.Desktop/Assets/icon.png"
                           Width="112"
                           Height="112"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="50%,50%">
                        <Image.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Image.RenderTransform>
                    </Image>

                    <StackPanel x:Name="WelcomePanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,48,0"
                                Opacity="0"
                                Spacing="18"
                                IsHitTestVisible="False">
                        <TextBlock x:Name="LabWelcome"
                                   Text="欢迎使用 PCL N Edition"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <legacy:MyButton x:Name="BtnStartSetup"
                                         Text="开始配置"
                                         ColorType="Highlight"
                                         UseExperimentalStyle="True"
                                         MinWidth="148"
                                         Height="36"
                                         Padding="18,0"
                                         HorizontalAlignment="Left"
                                         Click="BtnStartSetup_Click" />
                    </StackPanel>
                </Grid>

                <!-- Pages 2–3: legal markdown (MD H1 acts as title) -->
                <Grid x:Name="PageLegal"
                      Opacity="0"
                      IsHitTestVisible="False"
                      IsVisible="False"
                      Margin="28,18,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <legacy:MyScrollViewer Grid.Row="0"
                                           x:Name="PanLegalScroll"
                                           Margin="0,-4,0,16"
                                           Padding="2,0,8,0"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Disabled">
                        <legacy:MyMarkdownViewer x:Name="LabLegalMarkdown"
                                                 VerticalAlignment="Top"
                                                 FontSize="15"
                                                 Foreground="{DynamicResource ColorBrush1}" />
                    </legacy:MyScrollViewer>

                    <Grid Grid.Row="1"
                          x:Name="PanLegalActions"
                          ColumnDefinitions="*,Auto,Auto,Auto"
                          Margin="0,4,0,0">
                        <legacy:MyButton x:Name="BtnLegalDisagree"
                                         Grid.Column="1"
                                         ColorType="Red"
                                         UseExperimentalStyle="True"
                                         Text="不同意"
                                         MinWidth="120"
                                         Height="36"
                                         Padding="14,0"
                                         Margin="0,0,10,0"
                                         Click="BtnLegalDisagree_Click" />
                        <legacy:MyButton x:Name="BtnLegalPrev"
                                         Grid.Column="2"
                                         ColorType="Normal"
                                         UseExperimentalStyle="True"
                                         Text="上一页"
                                         MinWidth="110"
                                         Height="36"
                                         Padding="14,0"
                                         Margin="0,0,10,0"
                                         Click="BtnLegalPrev_Click" />
                        <legacy:MyButton x:Name="BtnLegalNext"
                                         Grid.Column="3"
                                         ColorType="Highlight"
                                         UseExperimentalStyle="True"
                                         Text="下一页"
                                         MinWidth="120"
                                         Height="36"
                                         Padding="14,0"
                                         Click="BtnLegalNext_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
