<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="clr-namespace:PCL.Desktop.Controls.Legacy"
    xmlns:presenters="clr-namespace:Avalonia.Controls.Presenters;assembly=Avalonia.Controls">
  <Styles.Resources>
    <x:Double x:Key="BlurRadius">0</x:Double>
    <x:Double x:Key="BlurSamplingRate">0.7</x:Double>

    <FontFamily x:Key="LaunchFontFamily">Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Noto Sans SC, WenQuanYi Micro Hei, Segoe UI, DejaVu Sans, Arial</FontFamily>

    <SolidColorBrush x:Key="ColorBrush1" Color="#343d4a" />
    <SolidColorBrush x:Key="ColorBrush2" Color="#0b5bcb" />
    <SolidColorBrush x:Key="ColorBrush3" Color="#1370f3" />
    <SolidColorBrush x:Key="ColorBrush4" Color="#4890f5" />
    <SolidColorBrush x:Key="ColorBrush5" Color="#96c0f9" />
    <SolidColorBrush x:Key="ColorBrush6" Color="#d5e6fd" />
    <SolidColorBrush x:Key="ColorBrush7" Color="#e0eafd" />
    <SolidColorBrush x:Key="ColorBrush8" Color="#eaf2fe" />
    <SolidColorBrush x:Key="ColorBrushBg0" Color="#96c0f9" />
    <SolidColorBrush x:Key="ColorBrushBg1" Color="#bee0eafd" />
    <Color x:Key="ColorObject1">#343d4a</Color>
    <Color x:Key="ColorObject2">#0b5bcb</Color>
    <Color x:Key="ColorObject3">#1370f3</Color>
    <Color x:Key="ColorObject4">#4890f5</Color>
    <Color x:Key="ColorObject5">#96c0f9</Color>
    <Color x:Key="ColorObject6">#d5e6fd</Color>
    <Color x:Key="ColorObject7">#e0eafd</Color>
    <Color x:Key="ColorObject8">#eaf2fe</Color>

    <SolidColorBrush x:Key="ColorBrushGray1" Color="#404040" />
    <SolidColorBrush x:Key="ColorBrushGray2" Color="#737373" />
    <SolidColorBrush x:Key="ColorBrushGray3" Color="#8c8c8c" />
    <SolidColorBrush x:Key="ColorBrushGray4" Color="#a6a6a6" />
    <SolidColorBrush x:Key="ColorBrushGray5" Color="#cccccc" />
    <SolidColorBrush x:Key="ColorBrushGray6" Color="#ebebeb" />
    <SolidColorBrush x:Key="ColorBrushGray7" Color="#f0f0f0" />
    <SolidColorBrush x:Key="ColorBrushGray8" Color="#f5f5f5" />

    <SolidColorBrush x:Key="ColorBrushRedBack" Color="#80fbdddd" />
    <SolidColorBrush x:Key="ColorBrushRedLight" Color="#ff4c4c" />
    <SolidColorBrush x:Key="ColorBrushRedDark" Color="#ce2111" />
    <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#55ffffff" />
    <SolidColorBrush x:Key="ColorBrushSemiWhite" Color="#bbffffff" />
    <SolidColorBrush x:Key="ColorBrushWhite" Color="#ffffff" />
    <SolidColorBrush x:Key="ColorBrushTransparent" Color="#00ffffff" />
    <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#01eaf2fe" />
    <SolidColorBrush x:Key="ColorBrushTransparentBackground" Color="#d2fbfbfb" />
    <!-- Fallback only; live value is written by ThemeColorPalette on theme apply. -->
    <SolidColorBrush x:Key="ColorBrushBackgroundTransparentSidebar" Color="#F1FFFFFF" />
    <SolidColorBrush x:Key="ColorBrushBackground" Color="#fbfbfb" />
    <SolidColorBrush x:Key="ColorBrushToolTip" Color="#e5ffffff" />

<SolidColorBrush x:Key="ColorBrushMemory" Color="#000000" />

    <!-- Settings pages migrated from WPF originals. -->
<!-- Migrated localization defaults for copied WPF pages. -->
</Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource LaunchFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ColorBrushToolTip}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="legacy|MyTextBox">
    <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource ColorBrushGray1}" />
    <Setter Property="FontFamily" Value="{DynamicResource LaunchFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MaxLength" Value="1000" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,0,6,0" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ColorBrush3}" />
    <Setter Property="UndoLimit" Value="15" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ClipToBounds="False">
          <Grid.RowDefinitions>
            <RowDefinition MinHeight="28" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="border"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ScrollViewer x:Name="PART_ScrollViewer"
                          Margin="5,0,0,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Auto">
              <Panel>
                <presenters:TextPresenter x:Name="PART_TextPresenter"
                                          Text="{TemplateBinding Text, Mode=TwoWay}"
                                          PasswordChar="{TemplateBinding PasswordChar}"
                                          RevealPassword="{TemplateBinding RevealPassword}"
                                          CaretIndex="{TemplateBinding CaretIndex}"
                                          SelectionStart="{TemplateBinding SelectionStart}"
                                          SelectionEnd="{TemplateBinding SelectionEnd}"
                                          TextAlignment="{TemplateBinding TextAlignment}"
                                          TextWrapping="{TemplateBinding TextWrapping}"
                                          LineHeight="{TemplateBinding LineHeight}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </ScrollViewer>
          </Border>
          <Border Margin="{TemplateBinding Padding}"
                  BorderThickness="0"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  IsHitTestVisible="False">
            <TextBlock x:Name="labHint"
                       Margin="7,0,0,0"
                       Padding="{TemplateBinding BorderThickness}"
                       FontFamily="{DynamicResource LaunchFontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{DynamicResource ColorBrushGray4}" />
          </Border>
          <TextBlock x:Name="labWrong"
                     Grid.Row="1"
                     Height="0"
                     Opacity="0"
                     IsVisible="False"
                     Foreground="{TemplateBinding BorderBrush}"
                     Padding="0,4,0,0"
                     Margin="0,0,0,-3" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="legacy|MyComboBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrushBg0}" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MaxDropDownHeight" Value="160" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding Foreground}"
                  BorderThickness="1"
                  CornerRadius="4" />
          <ToggleButton Margin="0,0,1.5,0"
                        Foreground="{TemplateBinding Foreground}"
                        IsTabStop="False"
                        Focusable="False"
                        IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate>
                <Border Background="{DynamicResource ColorBrushSemiTransparent}" />
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="PART_Content"
                            Margin="8.5,0,21.5,0"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionText}" />
          <legacy:MyTextBox x:Name="PART_EditableTextBox"
                            Margin="1.5,0,21.5,0"
                            Padding="0"
                            BorderThickness="0"
                            Background="{DynamicResource ColorBrushTransparent}"
                            IsVisible="False" />
          <Path x:Name="PART_DropDownArrow"
                Width="15"
                Height="15"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,1.5,0"
                IsHitTestVisible="False"
                Data="M1,1L4.5,4.5L8,1"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1.5"
                RenderTransformOrigin="30%,50%">
            <Path.RenderTransform>
              <RotateTransform />
            </Path.RenderTransform>
          </Path>
          <Popup x:Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen}"
                 Placement="Bottom"
                 VerticalOffset="-1.5">
            <Grid x:Name="PanPopup">
              <Border Background="{DynamicResource ColorBrushWhite}" CornerRadius="4" />
              <Border x:Name="dropDownBorder"
                      BorderBrush="{TemplateBinding Foreground}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="{TemplateBinding Width}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <legacy:MyScrollViewer x:Name="DropDownScrollViewer"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter x:Name="ItemsPresenter" />
                </legacy:MyScrollViewer>
              </Border>
            </Grid>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="legacy|MyComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <!-- Left pages: theme-tinted frosted strip (FormMain.RectLeftBackground) -->
  <Style Selector="legacy|MyPageLeft">
    <Setter Property="Background" Value="{DynamicResource ColorBrushBackgroundTransparentSidebar}" />
  </Style>

  <!-- WPF-like thin scrollbar (after page enter animation settles) -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Margin" Value="0,2,1,2" />
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="9" />
    <Setter Property="MinHeight" Value="9" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ColorBrush5}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>

