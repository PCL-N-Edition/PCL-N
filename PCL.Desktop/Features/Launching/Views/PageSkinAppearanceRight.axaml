<legacy:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
    x:Class="PCL.Desktop.Features.Launching.Views.PageSkinAppearanceRight"
    Background="Transparent">
    <Grid x:Name="PanRoot"
          ColumnDefinitions="300,*"
          ClipToBounds="True">
        <Border Grid.Column="0"
                Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}"
                BorderBrush="{DynamicResource ColorBrushGray6}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid x:Name="PanProfileRail"
                  Margin="22,18,22,22"
                  RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Appearance.Current.Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Text="{DynamicResource Appearance.Current.Subtitle}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>

                <Border x:Name="PanCurrentCard"
                        Grid.Row="1"
                        Margin="0,14,0,12"
                        CornerRadius="22"
                        Background="{DynamicResource ColorBrushWhite}"
                        BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1"
                        BoxShadow="0 10 30 0 #15000000"
                        ClipToBounds="True">
                    <Grid Margin="18,14,18,16"
                          RowDefinitions="*,Auto,Auto"
                          RowSpacing="4">
                        <legacy:MinecraftPlayerPreview x:Name="CurrentPlayer"
                                                       Grid.Row="0"
                                                       View="Front"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch" />
                        <TextBlock x:Name="LabProfileName"
                                   Grid.Row="1"
                                   MaxWidth="220"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabProfileType"
                                   Grid.Row="2"
                                   MaxWidth="220"
                                   FontSize="11.5"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2"
                            Spacing="8">
                    <legacy:MyButton Height="38"
                                     CornerRadius="12"
                                     Padding="16,0"
                                     UseExperimentalStyle="True"
                                     ColorType="Highlight"
                                     Text="{DynamicResource Appearance.Action.LocalSkin}"
                                     Click="BtnLocalSkin_Click" />
                    <legacy:MyButton Height="38"
                                     CornerRadius="12"
                                     Padding="16,0"
                                     UseExperimentalStyle="True"
                                     Text="{DynamicResource Appearance.Action.Library}"
                                     Click="BtnSkinLibrary_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="PanContent"
              Grid.Column="1"
              RowDefinitions="Auto,*,Auto,*"
              Margin="26,20,26,24"
              MaxWidth="1320"
              HorizontalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="2,0,2,10">
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Appearance.Skins.Title}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Text="{DynamicResource Appearance.Skins.Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           x:Name="LabSkinCount"
                           VerticalAlignment="Bottom"
                           FontSize="11.5"
                           Foreground="{DynamicResource ColorBrushGray2}" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PanSkinScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanSkins"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="2,2,2,10" />
                </ScrollViewer>
                <Border x:Name="PanSkinsEmpty"
                        IsVisible="False"
                        Margin="2,2,2,10"
                        CornerRadius="18"
                        Background="{DynamicResource ColorBrushWhite}"
                        BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1">
                    <TextBlock Text="{DynamicResource Appearance.Skins.Empty}"
                               Margin="24"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </Border>
            </Grid>

            <Grid x:Name="PanCapeHeader"
                  Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  Margin="2,18,2,10">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="LabCapeTitle"
                               Text="{DynamicResource Appearance.Capes.Title}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabCapeSubtitle"
                               Text="{DynamicResource Appearance.Capes.Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           x:Name="LabCapeCount"
                           VerticalAlignment="Bottom"
                           FontSize="11.5"
                           Foreground="{DynamicResource ColorBrushGray2}" />
            </Grid>

            <Grid Grid.Row="3">
                <ScrollViewer x:Name="PanCapeScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanCapes"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="2,2,2,10" />
                </ScrollViewer>
                <Border x:Name="PanCapesEmpty"
                        IsVisible="False"
                        Margin="2,2,2,10"
                        CornerRadius="18"
                        Background="{DynamicResource ColorBrushWhite}"
                        BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1">
                    <TextBlock x:Name="LabCapeEmpty"
                               Text="{DynamicResource Appearance.Capes.Empty}"
                               Margin="24"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</legacy:MyPageRight>
