<legacy:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
    x:Class="PCL.Desktop.Features.Settings.Views.PageSetupExperimental">
    <legacy:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <legacy:MyHint Margin="0,15,0,0"
                           Theme="Yellow"
                           Text="{DynamicResource Setup.Experimental.Warning}" />

            <legacy:MyCard Margin="0,15" Title="{DynamicResource Setup.Experimental.JvmHost.Title}">
                <StackPanel Margin="25,40,25,18" Spacing="12">
                    <legacy:MyCheckBox x:Name="CheckExperimentalJvmHost"
                                       Tag="ExperimentalJvmLifecycleHost"
                                       Text="{DynamicResource Setup.Experimental.JvmHost.Enable}"
                                       PreviewChange="ExperimentalJvmHost_OnPreviewChange" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.JvmHost.Summary}"
                               TextWrapping="Wrap" Opacity="0.82" />
                    <Grid ColumnDefinitions="1*,18,1*">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Text="{DynamicResource Setup.Experimental.Benefits.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Setup.Experimental.JvmHost.Benefits}"
                                       TextWrapping="Wrap" Opacity="0.78" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Text="{DynamicResource Setup.Experimental.Risks.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Setup.Experimental.JvmHost.Risks}"
                                       TextWrapping="Wrap" Opacity="0.78" />
                        </StackPanel>
                    </Grid>
                    <legacy:MyHint Theme="Blue"
                                   Text="{DynamicResource Setup.Experimental.JvmHost.Scope}" />
                </StackPanel>
            </legacy:MyCard>

            <legacy:MyCard Margin="0,0,0,15" Title="{DynamicResource Setup.Experimental.AiRepair.Title}">
                <StackPanel Margin="25,40,25,18" Spacing="12">
                    <legacy:MyCheckBox x:Name="CheckExperimentalAiRepair"
                                       Tag="ExperimentalMinecraftAiRepair"
                                       Text="{DynamicResource Setup.Experimental.AiRepair.Enable}"
                                       PreviewChange="ExperimentalAiRepair_OnPreviewChange" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Summary}"
                               TextWrapping="Wrap" Opacity="0.82" />
                    <Grid ColumnDefinitions="1*,18,1*">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Text="{DynamicResource Setup.Experimental.Benefits.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Benefits}"
                                       TextWrapping="Wrap" Opacity="0.78" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Text="{DynamicResource Setup.Experimental.Risks.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Risks}"
                                       TextWrapping="Wrap" Opacity="0.78" />
                        </StackPanel>
                    </Grid>
                    <legacy:MyHint Theme="Blue"
                                   Text="{DynamicResource Setup.Experimental.AiRepair.Scope}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Provider.Title}"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                    <legacy:MyComboBox x:Name="ComboMinecraftAiProvider"
                                       Tag="ExperimentalMinecraftAiProvider">
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Provider.Local}"
                                               IsSelected="True" />
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Provider.OpenAiCompatible}" />
                    </legacy:MyComboBox>
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.LocalModel.Title}"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                    <legacy:MyComboBox x:Name="ComboMinecraftAiLocalModel"
                                       Tag="ExperimentalMinecraftAiLocalModel">
                        <legacy:MyComboBoxItem Content="Gemma 4 E2B Instruct · Q4_K_M · 约 3.11 GB（默认）"
                                               IsSelected="True" />
                        <legacy:MyComboBoxItem Content="Gemma 4 E4B Instruct · Q4_K_M · 约 4.98 GB（更高质量）" />
                        <legacy:MyComboBoxItem Content="自定义 GGUF 模型" />
                    </legacy:MyComboBox>
                    <legacy:MyHint Theme="Blue"
                                   Text="{DynamicResource Setup.Experimental.AiRepair.LocalModel.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Api.BaseUrl}" Opacity="0.72" />
                    <legacy:MyTextBox x:Name="TextMinecraftAiApiBaseUrl"
                                      Tag="ExperimentalMinecraftAiApiBaseUrl"
                                      LostFocus="PersistAiApiTextOption"
                                      HintText="{DynamicResource Setup.Experimental.AiRepair.Api.BaseUrl.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Api.Model}" Opacity="0.72" />
                    <legacy:MyTextBox x:Name="TextMinecraftAiApiModel"
                                      Tag="ExperimentalMinecraftAiApiModel"
                                      LostFocus="PersistAiApiTextOption"
                                      HintText="{DynamicResource Setup.Experimental.AiRepair.Api.Model.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Api.Key}" Opacity="0.72" />
                    <Grid ColumnDefinitions="*,12,Auto">
                        <TextBox x:Name="TextAiApiKey"
                                 Grid.Column="0"
                                 PasswordChar="●"
                                 PlaceholderText="{DynamicResource Setup.Experimental.AiRepair.Api.Key.Hint}"
                                 LostFocus="ApiKey_OnLostFocus" />
                        <legacy:MyButton Grid.Column="2"
                                         MinWidth="96"
                                         Text="{DynamicResource Setup.Experimental.AiRepair.Api.Key.Clear}"
                                         Click="ClearApiKey_OnClick" />
                    </Grid>
                    <TextBlock x:Name="AiApiKeyStatus"
                               Text="{DynamicResource Setup.Experimental.AiRepair.Api.Key.StoredHint}"
                               TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.TokenBudget}" Opacity="0.72" />
                    <legacy:MyTextBox x:Name="TextMinecraftAiTokenBudget"
                                      Tag="ExperimentalMinecraftAiTokenBudget"
                                      MaxLength="5"
                                      LostFocus="PersistAiTokenBudget"
                                      HintText="4096" />
                    <legacy:MyHint Theme="Blue"
                                   Text="{DynamicResource Setup.Experimental.AiRepair.TokenBudget.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Api.Reasoning}" Opacity="0.72" />
                    <legacy:MyComboBox x:Name="ComboMinecraftAiReasoningEffort"
                                       Tag="ExperimentalMinecraftAiReasoningEffort">
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Api.Reasoning.None}"
                                               IsSelected="True" />
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Api.Reasoning.Low}" />
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Api.Reasoning.Medium}" />
                        <legacy:MyComboBoxItem Content="{DynamicResource Setup.Experimental.AiRepair.Api.Reasoning.High}" />
                    </legacy:MyComboBox>
                    <legacy:MyHint Theme="Yellow"
                                   Text="{DynamicResource Setup.Experimental.AiRepair.Api.Privacy}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Custom.Title}"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Custom.ModelPath}" Opacity="0.72" />
                    <legacy:MyTextBox Tag="ExperimentalMinecraftAiModelPath"
                                      HintText="{DynamicResource Setup.Experimental.AiRepair.Custom.ModelPath.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Custom.Sha256}" Opacity="0.72" />
                    <legacy:MyTextBox Tag="ExperimentalMinecraftAiModelSha256"
                                      MaxLength="64"
                                      HintText="{DynamicResource Setup.Experimental.AiRepair.Custom.Sha256.Hint}" />
                    <TextBlock Text="{DynamicResource Setup.Experimental.AiRepair.Custom.RuntimePath}" Opacity="0.72" />
                    <legacy:MyTextBox Tag="ExperimentalMinecraftAiRuntimePath"
                                      HintText="{DynamicResource Setup.Experimental.AiRepair.Custom.RuntimePath.Hint}" />
                </StackPanel>
            </legacy:MyCard>
        </StackPanel>
    </legacy:MyScrollViewer>
</legacy:MyPageRight>
