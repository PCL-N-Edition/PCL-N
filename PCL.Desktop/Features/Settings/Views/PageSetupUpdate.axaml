<legacy:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:PCL.Desktop.Controls.Legacy" x:Class="PCL.Desktop.Features.Settings.Views.PageSetupUpdate">
    <legacy:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <legacy:MyCard>
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Setup.Update.Channel.Title}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="0,0,25,0" />
                        <legacy:MyComboBox x:Name="ComboSystemUpdateChannel" Tag="SystemUpdateChannel" Grid.Column="1"
                                          Grid.ColumnSpan="3" Grid.Row="0"
                                          SelectedIndex="0"
                                          DropDownOpened="ComboSystemUpdateChannel_DropDownOpened"
                                          SelectionChanged="ComboSystemUpdateBranch_SelectionChanged">
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Channel.Release}"
                                                  ToolTip.Tip="{DynamicResource Setup.Update.Channel.Release.ToolTip}" />
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Channel.Beta}"
                                                  ToolTip.Tip="{DynamicResource Setup.Update.Channel.Beta.ToolTip}" />
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Channel.CI}"
                                                  ToolTip.Tip="{DynamicResource Setup.Update.Channel.CI.ToolTip}" />
                        </legacy:MyComboBox>
                        <TextBlock Text="{DynamicResource Setup.Update.Auto.Title}" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="0,0,25,0" />
                        <legacy:MyComboBox x:Name="ComboSystemUpdateMode" Tag="SystemUpdateMode" Grid.Column="1"
                                          Grid.ColumnSpan="3" Grid.Row="2"
                                          SelectedIndex="1"
                                          SelectionChanged="ComboSystemUpdateMode_SelectionChanged">
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Auto.DownloadAndInstall}" ToolTip.Tip="{DynamicResource Setup.Update.Auto.DownloadAndInstall.ToolTip}" />
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Auto.DownloadAndNotify}" ToolTip.Tip="{DynamicResource Setup.Update.Auto.DownloadAndNotify.ToolTip}" />
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Auto.NotifyOnly}" ToolTip.Tip="{DynamicResource Setup.Update.Auto.NotifyOnly.ToolTip}" />
                            <legacy:MyComboBoxItem Content="{DynamicResource Setup.Update.Auto.Disabled}" ToolTip.Tip="{DynamicResource Setup.Update.Auto.Disabled.ToolTip}" />
                        </legacy:MyComboBox>
                    </Grid>
                </StackPanel>
            </legacy:MyCard>

            <!-- Current version / check status (hidden when a newer build is available) -->
            <legacy:MyCard x:Name="CardCheck" Margin="0,15">
                <StackPanel Margin="20,20,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <legacy:MyImage Source="avares://PCL.Desktop/Assets/icon.png" Grid.Column="0" Grid.Row="0"
                                       Grid.RowSpan="3" Height="50" Width="50" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                        <TextBlock x:Name="TextCurrentVersion" Text="PCL N" FontWeight="Bold" FontSize="20"
                                   Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="TextCurrentDesc" Text="{DynamicResource Setup.Update.Latest}" FontSize="14" Grid.Row="2" Grid.Column="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <legacy:MyButton x:Name="BtnCheckAgain" Text="{DynamicResource Setup.Update.CheckAgain}" ColorType="Highlight" Grid.Row="0"
                                        Grid.RowSpan="2" Grid.Column="3" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Click="BtnCheckAgain_OnClick" />
                        <legacy:MyButton x:Name="BtnChangelog" Text="{DynamicResource Setup.Update.Changelog.View}" ColorType="Normal" Grid.Row="0"
                                        Grid.RowSpan="2" Grid.Column="5" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Click="BtnChangelog_Click" />
                    </Grid>
                </StackPanel>
            </legacy:MyCard>

            <!-- New version card (only when update available) -->
            <legacy:MyCard x:Name="CardUpdate" Margin="0,15" IsVisible="False">
                <StackPanel Margin="20,20,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="8" />
                            <RowDefinition />
                            <RowDefinition Height="10" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <legacy:MyImage x:Name="ImgUpdateIcon" Source="avares://PCL.Desktop/Assets/icon.png"
                                       Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Height="50" Width="50"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextUpdateName" Text="PCL N" FontWeight="Bold" FontSize="20"
                                   Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="TextUpdateDesc" Text="{DynamicResource Setup.Update.Available}" FontSize="14" Grid.Row="2"
                                   Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <legacy:MyButton x:Name="BtnDownloadNow" Text="{DynamicResource Setup.Update.DownloadNow}" ColorType="Normal"
                                        Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Click="BtnDownloadNow_Click" />
                        <legacy:MyButton x:Name="BtnDownloadAndInstall" Text="{DynamicResource Setup.Update.DownloadAndInstall}" ColorType="Highlight"
                                        Grid.Row="0" Grid.RowSpan="2" Grid.Column="5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Click="BtnDownloadAndInstall_Click" />
                        <TextBlock x:Name="TextChangelog"
                                    Text="{DynamicResource Setup.Update.Changelog.Placeholder}"
                                   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" TextWrapping="Wrap" />
                        <legacy:MyTextButton x:Name="BtnChangelogDetail" Text="{DynamicResource Setup.Update.Changelog.MoreInfo}" FontWeight="Thin"
                                            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" Click="BtnChangelogDetail_Click" />
                    </Grid>
                </StackPanel>
            </legacy:MyCard>
        </StackPanel>
    </legacy:MyScrollViewer>
</legacy:MyPageRight>
