<legacy:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
    x:Class="PCL.Desktop.Features.Instances.Views.PageInstanceSelectRight"
    Background="Transparent">
    <!--
      Full-page version library: frosted source sidebar + instance list (no hero titles).
      Mounted as the sole child of PanMain (no separate MyPageLeft).
    -->
    <Grid x:Name="PanRoot" ColumnDefinitions="268,*" ClipToBounds="True">

        <!-- Sidebar: only when experimental full-page layout is on -->
        <Border x:Name="PanFolderSidebar"
                Grid.Column="0"
                Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}"
                BorderBrush="{DynamicResource ColorBrushGray6}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                IsVisible="False">
            <legacy:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  x:Name="PanFolderScroll">
                <StackPanel x:Name="PanFolders" Margin="10,12,10,18" />
            </legacy:MyScrollViewer>
        </Border>

        <!-- Content: toolbar + library (no hero titles) -->
        <Grid x:Name="PanContent" Grid.Column="1" RowDefinitions="Auto,*" ClipToBounds="True">
            <Grid Margin="22,14,22,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <Border Padding="2"
                        CornerRadius="12"
                        Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1">
                    <legacy:MySearchBox x:Name="PanVerSearchBox"
                                        Margin="4,2"
                                        HintText="{DynamicResource Select.Instance.Search.Hint}"
                                        ToolTip="{DynamicResource Select.Instance.Search.ToolTip}" />
                </Border>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <legacy:MyButton x:Name="BtnDownloadHeader"
                                     MinWidth="108"
                                     Height="34"
                                     Padding="14,0"
                                     CornerRadius="10"
                                     ColorType="Highlight"
                                     Text="{DynamicResource Select.Instance.Empty.Download}"
                                     Click="BtnDownload_Click" />
                    <legacy:MyIconButton x:Name="BtnRefreshHeader"
                                         Width="34"
                                         Height="34"
                                         SvgIcon="lucide/refresh-cw"
                                         ToolTip="{DynamicResource Common.Action.Refresh}"
                                         Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid x:Name="PanAllBack">
                    <legacy:MyScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          x:Name="PanBack">
                        <StackPanel x:Name="PanMain"
                                    Margin="28,4,28,28"
                                    Grid.IsSharedSizeScope="True" />
                    </legacy:MyScrollViewer>

                    <Border x:Name="PanEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="40"
                            Padding="28,26"
                            MaxWidth="400"
                            CornerRadius="18"
                            Background="{DynamicResource ColorBrushWhite}"
                            BorderBrush="{DynamicResource ColorBrushGray6}"
                            BorderThickness="1"
                            IsVisible="False">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="LabEmptyTitle"
                                       HorizontalAlignment="Center"
                                       Text="{DynamicResource Select.Instance.Empty.Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       LetterSpacing="-0.3"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock x:Name="LabEmptyContent"
                                       Margin="4,0"
                                       Text="{DynamicResource Select.Instance.Empty.Message}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <legacy:MyButton Height="38"
                                            HorizontalAlignment="Center"
                                            x:Name="BtnEmptyDownload"
                                            MinWidth="156"
                                            Click="BtnDownload_Click"
                                            Text="{DynamicResource Select.Instance.Empty.Download}"
                                            Margin="0,8,0,0"
                                            Padding="18,0"
                                            CornerRadius="12"
                                            ColorType="Highlight" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanEmptySearch"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="40"
                            Padding="28,26"
                            MaxWidth="400"
                            CornerRadius="18"
                            Background="{DynamicResource ColorBrushWhite}"
                            BorderBrush="{DynamicResource ColorBrushGray6}"
                            BorderThickness="1"
                            IsVisible="False">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="LabEmptySearchTitle"
                                       HorizontalAlignment="Center"
                                       Text="{DynamicResource Select.Instance.EmptySearch.Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       LetterSpacing="-0.3"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock x:Name="LabEmptySearchContent"
                                       Margin="4,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="PanLoad"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40"
                        Padding="28,24"
                        CornerRadius="18"
                        Background="{DynamicResource ColorBrushWhite}"
                        BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1"
                        IsVisible="False">
                    <legacy:MyLoading Text="{DynamicResource Select.Instance.Loading}"
                                      x:Name="Load"
                                      HorizontalAlignment="Center"
                                      Click="Load_Click"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      AutoRun="False" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</legacy:MyPageRight>
