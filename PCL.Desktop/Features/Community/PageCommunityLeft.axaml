<!-- Community left rail: localized categories for community resources -->
<legacy:MyPageLeft x:Class="PCL.Desktop.Features.Community.PageCommunityLeft"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
                   Width="152">
    <legacy:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,0,0" x:Name="PanItem">
            <TextBlock Text="{DynamicResource Community.Left.Category}"
                       Margin="13,10,5,4"
                       Opacity="0.55"
                       FontSize="12"
                       FontWeight="SemiBold" />

            <legacy:MyListItem x:Name="ItemFavorites" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="Favorites" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.Favorites}" SvgIcon="lucide/star" LogoScale="0.95" />

            <legacy:MyListItem x:Name="ItemMod" Checked="True" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="Mod" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.Mod}" SvgIcon="lucide/puzzle" LogoScale="0.97" />
            <legacy:MyListItem x:Name="ItemPack" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="Modpack" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.Modpack}" SvgIcon="lucide/package" LogoScale="0.98" />
            <legacy:MyListItem x:Name="ItemDataPack" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="DataPack" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.DataPack}" SvgIcon="lucide/file-archive" LogoScale="0.96" />
            <legacy:MyListItem x:Name="ItemResourcePack" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="ResourcePack" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.ResourcePack}" SvgIcon="lucide/layers" LogoScale="0.81" />
            <legacy:MyListItem x:Name="ItemShader" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="Shader" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.Shader}" SvgIcon="lucide/sparkles" LogoScale="1.04" />
            <legacy:MyListItem x:Name="ItemWorld" Type="RadioBox" IsScaleAnimationEnabled="False"
                              Tag="World" Check="PageCheck" MinPaddingRight="35" Height="36"
                              Title="{DynamicResource Community.Left.World}" SvgIcon="lucide/globe" LogoScale="0.85" />
        </StackPanel>
    </legacy:MyScrollViewer>
</legacy:MyPageLeft>
