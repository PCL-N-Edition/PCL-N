<legacy:MyPageRight x:Class="PCL.Desktop.Features.Community.PageCommunityFavoritesRight"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:legacy="using:PCL.Desktop.Controls.Legacy">
    <legacy:MyScrollViewer x:Name="PanBack"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,20">
            <Grid Margin="2,0,0,15" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="收藏夹" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock x:Name="LabFolderSummary" Opacity="0.65" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <legacy:MyComboBox x:Name="ComboFolders"
                                       Height="28"
                                       MinWidth="110"
                                       MaxWidth="220"
                                       MaxDropDownHeight="320"
                                       DropDownWidthSync="False" />
                    <legacy:MyIconButton x:Name="BtnManageFolders"
                                         SvgIcon="lucide/settings"
                                         ToolTip="管理收藏夹"
                                         Width="25"
                                         Height="25"
                                         LogoScale="0.9"
                                         Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
            <legacy:MyCard UseAnimation="False">
                <StackPanel x:Name="PanFavorites" Margin="12" />
            </legacy:MyCard>
        </StackPanel>
    </legacy:MyScrollViewer>
</legacy:MyPageRight>
