<legacy:MyPageRight x:Class="PCL.Desktop.Features.Link.PageGameLink"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
                    xmlns:link="using:PCL.Application.Link"
                    xmlns:scf="using:PCL.Core.Link.Scaffolding.Client.Models">
    <Grid>
        <legacy:MyScrollViewer VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,14,20,20"
                  RowDefinitions="Auto,*,Auto">
                <legacy:MyHint Grid.Row="0"
                               Margin="0,0,0,12"
                               MinHeight="38"
                               Theme="{Binding StatusTheme}"
                               Text="{Binding StatusDetail}" />

                <StackPanel Grid.Row="1"
                            IsVisible="{Binding ShowAgreement}">
                    <legacy:MyCard Title="{DynamicResource Link.Page.Agreement.Title}"
                                   UseAnimation="False">
                        <StackPanel Margin="20,42,20,20"
                                    Spacing="12">
                            <TextBlock Text="{DynamicResource Link.Page.Agreement.Description}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                            <Border CornerRadius="6"
                                    Padding="14,12"
                                    Background="{DynamicResource ColorBrush8}">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{DynamicResource Link.Page.Agreement.Network}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Link.Page.Agreement.Body}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource ColorBrushGray2}"
                                               LineHeight="20" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        Margin="0,6,0,0">
                                <legacy:MyButton Text="{DynamicResource Link.Page.Agreement.EasyTier}"
                                                 Width="120"
                                                 Height="32"
                                                 Command="{Binding OpenUrlCommand}"
                                                 CommandParameter="https://easytier.cn/" />
                                <legacy:MyButton Text="{DynamicResource Link.Page.Agreement.Accept}"
                                                 Width="140"
                                                 Height="32"
                                                 ColorType="Highlight"
                                                 Command="{Binding AcceptAgreementCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </legacy:MyCard>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            IsVisible="{Binding ShowSelection}"
                            Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          Margin="0,0,0,2">
                        <TextBlock Text="{DynamicResource Link.Page.Select.Description}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray2}"
                                   TextWrapping="Wrap" />
                        <legacy:MyButton Grid.Column="1"
                                         Margin="10,0,0,0"
                                         Height="30"
                                         MinWidth="116"
                                         Text="{Binding NatSummary}"
                                         ToolTip="{DynamicResource Link.Page.Nat.Tooltip}"
                                         Command="{Binding TestNatCommand}" />
                        <Border Grid.Column="2"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                CornerRadius="8"
                                Background="{DynamicResource ColorBrush8}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <legacy:SvgIcon Width="14"
                                                Height="14"
                                                Icon="lucide/user"
                                                IconBrush="{DynamicResource ColorBrush1}" />
                                <TextBlock Text="{Binding UserName}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <legacy:MyCard Title="{DynamicResource Link.Page.Identity.Title}"
                                   UseAnimation="False">
                        <Grid Margin="20,42,20,18"
                              ColumnDefinitions="Auto,*">
                            <TextBlock Text="{DynamicResource Link.Page.Identity.Name}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <legacy:MyTextBox Grid.Column="1"
                                              Text="{Binding UserName, Mode=TwoWay}"
                                              HintText="{DynamicResource Link.Page.Identity.Hint}"
                                              MaxLength="64" />
                        </Grid>
                    </legacy:MyCard>

                    <legacy:MyCard Title="{DynamicResource Link.Page.Join.Title}"
                                   UseAnimation="False">
                        <StackPanel Margin="20,42,20,18"
                                    Spacing="12">
                            <TextBlock Text="{DynamicResource Link.Page.Join.Description}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="8">
                                <legacy:MyTextBox Text="{Binding LobbyCode, Mode=TwoWay}"
                                                  HintText="{DynamicResource Link.Page.Join.Hint}"
                                                  MaxLength="21" />
                                <legacy:MyButton Grid.Column="1"
                                                 Width="58"
                                                 Height="30"
                                                 Text="{DynamicResource Link.Page.Join.Clear}"
                                                 Command="{Binding ClearLobbyCodeCommand}" />
                                <legacy:MyButton Grid.Column="2"
                                                 Width="58"
                                                 Height="30"
                                                 Text="{DynamicResource Link.Page.Join.Paste}"
                                                 Command="{Binding PasteLobbyCodeCommand}" />
                                <legacy:MyButton Grid.Column="3"
                                                 Width="68"
                                                 Height="30"
                                                 Text="{DynamicResource Link.Page.Join.Action}"
                                                 ColorType="Highlight"
                                                 Command="{Binding JoinLobbyCommand}" />
                            </Grid>
                        </StackPanel>
                    </legacy:MyCard>

                    <legacy:MyCard Title="{DynamicResource Link.Page.Create.Title}"
                                   CanSwap="True"
                                   UseAnimation="False">
                        <StackPanel Margin="20,42,20,18"
                                    Spacing="12">
                            <TextBlock Text="{DynamicResource Link.Page.Create.Description}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                            <Grid ColumnDefinitions="1.4*,Auto,0.7*,Auto"
                                  ColumnSpacing="8">
                                <legacy:MyComboBox ItemsSource="{Binding Worlds}"
                                                   SelectedItem="{Binding SelectedWorld, Mode=TwoWay}"
                                                   Height="30"
                                                   HorizontalAlignment="Stretch">
                                    <legacy:MyComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="link:TerracottaWorld">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </legacy:MyComboBox.ItemTemplate>
                                </legacy:MyComboBox>
                                <legacy:MyButton Grid.Column="1"
                                                 Width="58"
                                                 Height="30"
                                                 Text="{DynamicResource Link.Page.Create.Refresh}"
                                                 Command="{Binding RefreshWorldsCommand}" />
                                <legacy:MyTextBox Grid.Column="2"
                                                  Text="{Binding ManualPort, Mode=TwoWay}"
                                                  HintText="{DynamicResource Link.Page.Create.ManualPort}"
                                                  MaxLength="5" />
                                <legacy:MyButton Grid.Column="3"
                                                 Width="68"
                                                 Height="30"
                                                 Text="{DynamicResource Link.Page.Create.Action}"
                                                 ColorType="Highlight"
                                                 Command="{Binding CreateLobbyCommand}" />
                            </Grid>
                        </StackPanel>
                    </legacy:MyCard>
                </StackPanel>

                <legacy:MyCard Grid.Row="1"
                               IsVisible="{Binding ShowLoading}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="470"
                               MaxWidth="650"
                               UseAnimation="False">
                    <StackPanel Margin="28,24,28,22"
                                Spacing="10">
                        <legacy:MyLoading Text="{Binding StatusTitle}"
                                          AutoRun="True"
                                          HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     Height="3"
                                     Margin="0,5,0,0" />
                    </StackPanel>
                </legacy:MyCard>

                <Grid Grid.Row="1"
                      IsVisible="{Binding ShowConnected}"
                      ColumnDefinitions="0.85*,1.35*"
                      RowDefinitions="Auto,Auto,*">
                    <legacy:MyCard Grid.Row="0"
                                   Grid.Column="0"
                                   Title="{DynamicResource Link.Page.Finish.InfoTitle}"
                                   Margin="0,0,12,12"
                                   UseAnimation="False">
                        <StackPanel Margin="20,42,20,18"
                                    Spacing="11">
                            <Grid ColumnDefinitions="Auto,*">
                                <legacy:SvgIcon Width="16" Height="16"
                                                Icon="lucide/activity"
                                                IconBrush="{DynamicResource ColorBrush2}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0"
                                           Text="{Binding ConnectionQuality}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <legacy:SvgIcon Width="16" Height="16"
                                                Icon="lucide/radio"
                                                IconBrush="{DynamicResource ColorBrush2}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0"
                                           Text="{Binding LatencyText}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <legacy:SvgIcon Width="16" Height="16"
                                                Icon="lucide/network"
                                                IconBrush="{DynamicResource ColorBrush2}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0"
                                           Text="{Binding ConnectionType}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <legacy:SvgIcon Width="16" Height="16"
                                                Icon="lucide/user"
                                                IconBrush="{DynamicResource ColorBrush2}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0"
                                           Text="{Binding RoleText}" />
                            </Grid>
                        </StackPanel>
                    </legacy:MyCard>

                    <legacy:MyCard Grid.Row="1"
                                   Grid.Column="0"
                                   Title="{DynamicResource Link.Page.Finish.Actions}"
                                   Margin="0,0,12,0"
                                   UseAnimation="False">
                        <StackPanel Margin="20,42,20,18"
                                    Spacing="8">
                            <legacy:MyButton Height="31"
                                             Text="{DynamicResource Link.Page.Finish.CopyIp}"
                                             Command="{Binding CopyLocalAddressCommand}" />
                            <legacy:MyButton Height="31"
                                             Text="{DynamicResource Link.Page.Finish.CopyCode}"
                                             Command="{Binding CopyLobbyCodeCommand}" />
                            <legacy:MyButton Height="31"
                                             Text="{DynamicResource Link.Page.Finish.Exit}"
                                             ColorType="Red"
                                             Command="{Binding LeaveCommand}" />
                        </StackPanel>
                    </legacy:MyCard>

                    <legacy:MyCard Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Grid.Column="1"
                                   Title="{DynamicResource Link.Page.Member.Title}"
                                   UseAnimation="False">
                        <Grid Margin="18,42,18,18"
                              RowDefinitions="Auto,Auto,*">
                            <TextBlock Text="{Binding LobbyCode}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding LocalAddress}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrushGray2}"
                                       Margin="0,0,0,14" />
                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="scf:PlayerProfile">
                                        <Border Margin="0,0,0,8"
                                                Padding="12,10"
                                                CornerRadius="7"
                                                Background="{DynamicResource ColorBrush8}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        Background="{DynamicResource ColorBrush5}">
                                                    <legacy:SvgIcon Width="16"
                                                                    Height="16"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Icon="lucide/user"
                                                                    IconBrush="{DynamicResource ColorBrush1}" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="11,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Vendor}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ColorBrushGray2}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Kind}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ColorBrushGray2}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </legacy:MyCard>
                </Grid>

                <legacy:MyCard Grid.Row="2"
                               IsVisible="{Binding AgreementAccepted}"
                               Margin="0,12,0,0"
                               UseAnimation="False">
                    <StackPanel Margin="14,9"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Opacity="0.72">
                        <TextBlock Text="{DynamicResource Link.Page.Footer.Friends}" />
                        <legacy:MyTextButton Text="EasyTier"
                                             Command="{Binding OpenUrlCommand}"
                                             CommandParameter="https://easytier.cn/" />
                        <TextBlock Text=" | " />
                        <legacy:MyTextButton Text="{DynamicResource Link.Page.Footer.Disable}"
                                             Command="{Binding DisableAgreementCommand}" />
                    </StackPanel>
                </legacy:MyCard>
            </Grid>
        </legacy:MyScrollViewer>
    </Grid>
</legacy:MyPageRight>
