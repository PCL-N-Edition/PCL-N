<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="PclN.Launcher"
      Name="PCL N"
      Manufacturer="PCL N contributors"
      Version="$(var.ProductVersion)"
      UpgradeCode="66C80FA6-C2D6-4E10-9A2E-7EA5B99729D8"
      Scope="perUser"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PCL N is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PCL N">
          <Component Id="LauncherComponent" Guid="*">
            <File Id="LauncherExecutable" Source="$(var.SourceExecutable)" KeyPath="yes">
              <Shortcut
                  Id="ApplicationStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="PCL N"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />
            </File>
            <File Id="InstallKindMarker" Source="$(var.InstallKindMarker)" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="MainFeature" Title="PCL N" Level="1">
      <ComponentRef Id="LauncherComponent" />
    </Feature>
  </Package>
</Wix>
