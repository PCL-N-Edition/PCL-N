<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows MSI for multi-file (scatter) layout.
  PayloadDir is the published artifact root containing PCL-N-Edition.exe + host/ + zips.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="PclN.Launcher"
      Name="PCL N"
      Manufacturer="PCL N contributors"
      Version="$(var.ProductVersion)"
      UpgradeCode="66C80FA6-C2D6-4E10-9A2E-7EA5B99729D8"
      Scope="perUser"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PCL N is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PCL N" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Harvest entire scatter layout into INSTALLFOLDER (WiX Files, toolset 5+). -->
    <ComponentGroup Id="ScatterPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="InstallMarkers" Directory="INSTALLFOLDER">
      <Component Id="InstallKindMarker" Guid="*">
        <File Id="InstallKindMarkerFile" Source="$(var.InstallKindMarker)" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="PCL N"
            Target="[INSTALLFOLDER]PCL-N-Edition.exe"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
        <RegistryValue
            Root="HKCU"
            Key="Software\PCL N"
            Name="InstallDir"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="PCL N" Level="1">
      <ComponentGroupRef Id="ScatterPayload" />
      <ComponentGroupRef Id="InstallMarkers" />
    </Feature>
  </Package>
</Wix>
