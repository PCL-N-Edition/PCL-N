<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Canonical framework-neutral semantic renderer for XSR.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The namespace is locked to the Nexa.UI.Next project identity; CA1716 cannot be satisfied without renaming the architecture. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Nexa.Core/Nexa.Core.csproj" />
    <ProjectReference Include="../Nexa.Xsr.Abstractions/Nexa.Xsr.Abstractions.csproj" />
    <ProjectReference Include="../Nexa.Xsr.State/Nexa.Xsr.State.csproj" />
  </ItemGroup>
</Project>
