<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- HotSpot initialization is incompatible with CET on affected Windows runtimes.
         Keep this exception isolated from the Desktop process. -->
    <CETCompat>false</CETCompat>
    <ApplicationIcon>../Nexa.Desktop/Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexa.Services/Nexa.Services.csproj" />
  </ItemGroup>
</Project>
