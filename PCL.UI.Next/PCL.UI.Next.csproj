<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PCL.UI.Next</AssemblyName>
    <RootNamespace>PCL.UI.Next</RootNamespace>
    <Description>PCL N next-generation ECS UI render architecture (experimental)</Description>
    <Company>PCL N</Company>
    <Product>PCL.UI.Next</Product>
    <Copyright>Copyright (c) 2026 PCL N contributors</Copyright>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- Product name is intentionally PCL.UI.Next; CA1716 flags "Next" as a VB reserved word.
         CA1711: EventQueue/StatePatchQueue/UiDirtyFlags names match architecture doc. -->
    <NoWarn>$(NoWarn);CA1716;CA1711;CA1036;CA1512;CA1305;CA1720;CA1805;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PCL.UI.Next.Test" />
    <InternalsVisibleTo Include="PCL.UI.Next.Playground" />
    <InternalsVisibleTo Include="PCL.UI.Next.Backend.Avalonia.Test" />
    <InternalsVisibleTo Include="PCL.UI.Next.Benchmarks" />
    <InternalsVisibleTo Include="PCL.UI.Next.DevTools.Test" />
  </ItemGroup>
</Project>
